---
import Layout from "@/layouts/main.astro"

export function getStaticPaths() {
  const categories = [
    {
      slug: "t-shirts",
      currentActive: "t-shirts" as const,
      title: "Custom Printed T-Shirts",
      tagline: "Ultra-comfortable cotton & poly tees with vivid, wash-proof custom prints.",
      startingPrice: "₹299",
      minOrder: "1 Piece (Bulk discounts available)",
      turnaround: "24-48 Hours",
      materials: ["100% Bio-Washed Combed Cotton (180-220 GSM)", "Poly-Cotton Moisture-Wicking Dry Fit", "Heavyweight Oversized Cotton (240 GSM)"],
      printMethods: ["Direct to Film (DTF)", "Screen Printing", "High-Density Vinyl", "Sublimation (Polyester)"],
      options: ["Round Neck", "Polo Collar", "Oversized Fit", "V-Neck", "Hoodies & Sweatshirts"],
      highlights: [
        { title: "No Color Limit", desc: "Print full-color gradients, photographs, and complex typography with crisp clarity." },
        { title: "Wash-Tested Durability", desc: "Formulated inks that withstand 50+ machine washes without peeling or cracking." },
        { title: "Eco-Friendly Inks", desc: "Non-toxic, OEKO-TEX certified inks that are safe for sensitive skin and children." }
      ],
      faqs: [
        { q: "What is the minimum order quantity for custom t-shirts?", a: "There is no minimum order! You can order just 1 single customized t-shirt or thousands for corporate events." },
        { q: "What format should I upload my design in?", a: "High-resolution PNG (300 DPI with transparent background), PDF, AI, or PSD files produce the best print results." },
        { q: "Can you print front and back?", a: "Yes! We offer front, back, chest pocket, and sleeve print placements." }
      ]
    },
    {
      slug: "mobile-case",
      currentActive: "mobile-case" as const,
      title: "Custom Mobile Cases",
      tagline: "Shockproof phone cases with brilliant edge-to-edge personalized artwork.",
      startingPrice: "₹199",
      minOrder: "1 Piece",
      turnaround: "24 Hours",
      materials: ["Polycarbonate Hard Matte Plastic", "Tempered Glass Back with TPU Bumpers", "Flexible Soft Silicone TPU"],
      printMethods: ["3D Sublimation Wrap-Around", "UV Hard Inkjet Embossed", "Laser Foil Inlay"],
      options: ["iPhone (All Series)", "Samsung Galaxy", "OnePlus", "Google Pixel", "Xiaomi / Redmi / Realme"],
      highlights: [
        { title: "Full Edge-to-Edge Print", desc: "Artwork wraps seamlessly around sides and corners without white edges." },
        { title: "Camera & Screen Lip", desc: "Raised bezels safeguard delicate lenses and displays against drops." },
        { title: "Scratch & Fade Proof", desc: "Sub-surface dye sublimation makes prints impervious to key scratches and daily wear." }
      ],
      faqs: [
        { q: "Do you support my specific phone model?", a: "We stock cases for over 500+ phone models across all major manufacturers. Contact us with your model name." },
        { q: "Will the print fade with hand sweat?", a: "Not at all. The design is heat-infused into the case material and will never peel or fade." }
      ]
    },
    {
      slug: "key-chain",
      currentActive: "key-chain" as const,
      title: "Personalized Key Chains",
      tagline: "Custom acrylic, metal, and wooden keychains cut to any custom contour.",
      startingPrice: "₹49",
      minOrder: "1 Piece (Great for bulk favors)",
      turnaround: "24 Hours",
      materials: ["High-Gloss Acrylic (3mm)", "Solid Polished Metal Alloy", "Birch & Walnut Wood"],
      printMethods: ["UV Digital Flatbed", "Double-Sided Acrylic Sandwich", "Fiber Laser Engraving"],
      options: ["Custom Die-Cut Shapes", "Photo Rectangle/Circle", "QR Code Spotify/Website", "Bike/Car Number Plate"],
      highlights: [
        { title: "Precision Laser Cut", desc: "Smooth polished edges cut into any custom silhouette or brand mascot." },
        { title: "Heavy-Duty Rings", desc: "Supplied with rust-proof stainless steel split rings and swivel clasps." },
        { title: "Double-Sided Visibility", desc: "Option to print different pictures or text on front and back." }
      ],
      faqs: [
        { q: "Can I get keychains in custom brand logo shapes?", a: "Yes, we laser cut the outline following your exact logo silhouette." },
        { q: "Are these suitable as wedding or birthday return gifts?", a: "Absolutely! Custom keychains are our most popular return gift and corporate giveaway item." }
      ]
    },
    {
      slug: "photo-frame",
      currentActive: "photo-frame" as const,
      title: "Personalized Photo Frames",
      tagline: "Cherish life's greatest moments with gallery-quality acrylic and wood frames.",
      startingPrice: "₹349",
      minOrder: "1 Piece",
      turnaround: "2-3 Days",
      materials: ["Cast Virgin Acrylic (3mm - 8mm)", "Solid Pinewood & Teak Finish Frames", "MDF Wood Desktop Stands"],
      printMethods: ["Direct UV Printing onto Acrylic", "Fine-Art Archival Paper with Matte Lamination"],
      options: ["A4 (8x12 in)", "A3 (12x18 in)", "Square 12x12 in", "Desk 6x8 in", "Custom Mega Wall Sizes"],
      highlights: [
        { title: "Ultra HD Clarity", desc: "Vivid color reproduction with deep blacks and high dynamic range." },
        { title: "Frameless Floating Effect", desc: "Wall-mount acrylic frames come with stainless steel standoff bolts." },
        { title: "Shatter-Resistant", desc: "Lighter and 17x stronger than fragile glass, safe around children." }
      ],
      faqs: [
        { q: "Does the acrylic frame come with mounting hardware?", a: "Yes, every wall frame includes premium stainless steel mounting studs and wall plugs." },
        { q: "Can you create a collage for me?", a: "Yes! Simply provide up to 10 photos and our design team can assemble an elegant collage proof." }
      ]
    },
    {
      slug: "photo-frame-clock",
      currentActive: "photo-frame-clock" as const,
      title: "Photo Frame Clocks",
      tagline: "A functional timepiece meets cherished memories in a personalized photo clock.",
      startingPrice: "₹599",
      minOrder: "1 Piece",
      turnaround: "2-3 Days",
      materials: ["Engineered MDF Wood Face", "Acrylic Glass Front", "Silent Quartz Sweep Movement"],
      printMethods: ["Direct UV Flatbed Print", "Laminated Vinyl Surface Mounted"],
      options: ["Round 12 inch", "Square 12x12 inch", "Heart Collage 14 inch", "Family Tree 16x16 inch"],
      highlights: [
        { title: "Silent Quartz Mechanism", desc: "No annoying ticking sound; smooth continuous sweep second hand." },
        { title: "Up to 12 Photo Slots", desc: "Place photos for every hour mark or a grand center family portrait." },
        { title: "Ready to Hang", desc: "Integrated rear wall bracket and complimentary AA battery included." }
      ],
      faqs: [
        { q: "Is the clock mechanism covered under warranty?", a: "Yes, the quartz clock machine comes with a 1-year replacement warranty." },
        { q: "Can text like names and wedding dates be added?", a: "Yes, names, anniversary dates, and quotes are added at no extra charge." }
      ]
    },
    {
      slug: "cushion-cover",
      currentActive: "cushion-cover" as const,
      title: "Custom Cushion Covers",
      tagline: "Bring comfort and style home with customized photo & typography cushions.",
      startingPrice: "₹249",
      minOrder: "1 Piece",
      turnaround: "24-48 Hours",
      materials: ["Premium Glossy Satin", "Textured Organic Canvas Cotton", "Plush Micro-Velvet", "Magic Sequin Reversible"],
      printMethods: ["High-Pressure Dye Sublimation", "Direct-to-Fabric Digital"],
      options: ["12x12 inch", "16x16 inch (Standard)", "Heart Shape", "18x18 inch Large"],
      highlights: [
        { title: "Concealed Smooth Zipper", desc: "Hidden zipper for seamless aesthetic and easy machine washing." },
        { title: "Fade-Free Dyes", desc: "Dyes bond with fibers at molecular levels for permanent vibrant colors." },
        { title: "Hypoallergenic Fillers", desc: "Optional virgin micro-fiber cushion inserts for maximum fluffiness." }
      ],
      faqs: [
        { q: "Is the cushion filler included?", a: "You can purchase cover-only or complete cushions with plush virgin fiber filler." },
        { q: "Can I wash the cushion cover?", a: "Yes, all our cushion covers are 100% machine-washable in cold water." }
      ]
    },
    {
      slug: "table-mat",
      currentActive: "table-mat" as const,
      title: "Custom Table & Desk Mats",
      tagline: "Protect your surfaces in style with branded dining, mouse, and counter mats.",
      startingPrice: "₹149",
      minOrder: "1 Piece",
      turnaround: "24-48 Hours",
      materials: ["Heat-Resistant Washable PVC", "Silky Micro-Weave Fabric with Natural Rubber Base", "Leatherette"],
      printMethods: ["UV Durable Flatbed Print", "Continuous Sublimation Printing"],
      options: ["Dining Placemat (12x18 in)", "Desk Mousepad Mat (300x800mm)", "Bar & Counter Runner (10x36 in)"],
      highlights: [
        { title: "Anti-Slip Rubber Grip", desc: "Stays firmly planted on glass, polished wood, and granite surfaces." },
        { title: "Water & Stain Repellent", desc: "Curry, coffee, and liquid spills easily wipe clean with a wet cloth." },
        { title: "Anti-Fray Stitched Edges", desc: "Reinforced perimeter stitching prevents surface peeling over time." }
      ],
      faqs: [
        { q: "Can these handle hot plates?", a: "Yes, our dining mats withstand temperatures up to 85°C without warping." },
        { q: "Do you make gaming desk pads?", a: "Yes, our large fabric-top rubber-bottom mats are optimized for high-precision mouse tracking." }
      ]
    },
    {
      slug: "water-bottle",
      currentActive: "water-bottle" as const,
      title: "Personalized Water Bottles",
      tagline: "Eco-friendly stainless steel and aluminum bottles customized with names and logos.",
      startingPrice: "₹399",
      minOrder: "1 Piece",
      turnaround: "24-48 Hours",
      materials: ["Food-Grade 304 Stainless Steel (Double Walled)", "Lightweight Sports Aluminum"],
      printMethods: ["Full 360° Rotary UV Print", "Precision Fiber Laser Engraving", "Dye Sublimation"],
      options: ["500ml Flask (Hot/Cold)", "750ml Sports Sipper", "1000ml Gym Bottle", "Temperature Display Flask"],
      highlights: [
        { title: "12 Hr Hot / 24 Hr Cold", desc: "Vacuum insulation prevents outer condensation and maintains beverage temperature." },
        { title: "Permanent Laser Marking", desc: "Laser etching will never chip, fade, or wash off with daily detergent cleaning." },
        { title: "100% BPA Free", desc: "Non-reactive food grade steel that keeps water fresh with zero metallic taste." }
      ],
      faqs: [
        { q: "Can individual names be printed for corporate teams?", a: "Yes! Each bottle in a batch can carry a unique employee name alongside the company logo." },
        { q: "Are these leak-proof?", a: "Every bottle features silicone sealed airtight caps tested for zero leaks inside bags." }
      ]
    },
    {
      slug: "cap",
      currentActive: "cap" as const,
      title: "Custom Embroidered & Printed Caps",
      tagline: "Premium structured baseball caps and snapbacks personalized for brands and teams.",
      startingPrice: "₹199",
      minOrder: "1 Piece",
      turnaround: "2-3 Days",
      materials: ["100% Heavy Brushed Cotton Twill", "Breathable Polyester Mesh (Trucker)", "Ripstop Poly"],
      printMethods: ["3D Puff Embroidery", "Flat High-Density Embroidery", "Full-Color DTF Heat Press"],
      options: ["6-Panel Baseball Cap", "5-Panel Trucker Cap", "Flat Brim Snapback", "Sun Visor"],
      highlights: [
        { title: "Structured Crown", desc: "Holds its shape over years of wearing without collapsing." },
        { title: "Adjustable Closure", desc: "Brass buckle or snapback clasp ensures a universal snug fit for all head sizes." },
        { title: "Sweatband Lining", desc: "Padded moisture-wicking internal sweatband for comfort in hot weather." }
      ],
      faqs: [
        { q: "What's better: embroidery or printing on caps?", a: "Embroidery gives a classic, textured, ultra-premium look, while printing is ideal for intricate multi-color gradients." },
        { q: "Can you embroider the sides and back?", a: "Yes, we can add smaller logos or initials to the sides and rear arch." }
      ]
    },
    {
      slug: "pens",
      currentActive: "pens" as const,
      title: "Custom Engraved & Printed Pens",
      tagline: "Sleek metallic and corporate promotional pens engraved with names and logos.",
      startingPrice: "₹29",
      minOrder: "1 Piece (Metal) / 50 Pieces (Plastic Promotional)",
      turnaround: "24-48 Hours",
      materials: ["Heavyweight Metal Brass & Aluminum Alloy", "Matte Finish Soft-Touch ABS Plastic"],
      printMethods: ["High-Precision Fiber Laser Etch", "Multi-Color Pad Printing", "Rotary Screen"],
      options: ["Rollerball Gel Pen", "Twist Ballpoint Pen", "Fountain Pen", "Stylus 2-in-1 Pen"],
      highlights: [
        { title: "German Refill Technology", desc: "Delivers effortless, smudge-free, 0.7mm smooth writing performance." },
        { title: "Subtle Gold / Silver Etch", desc: "Laser exposes raw metal substrate underneath for an executive look." },
        { title: "Executive Gift Packaging", desc: "Comes in velvet pouches or rigid magnet-lock presentation boxes." }
      ],
      faqs: [
        { q: "Can I order a single pen with my friend's name as a gift?", a: "Yes! Single personalized engraved pens in gift boxes are available with 24-hour turnaround." },
        { q: "Do you supply refills?", a: "All our pens accept standard Parker-style or universal refills widely available anywhere." }
      ]
    },
    {
      slug: "banner",
      currentActive: "banner" as const,
      title: "Custom Banners & Standees",
      tagline: "Weatherproof flex banners and roll-up standees engineered for maximum visibility.",
      startingPrice: "₹15/sq.ft",
      minOrder: "1 Piece",
      turnaround: "Same Day / 24 Hours",
      materials: ["Normal & Star Flex (280 - 440 GSM)", "Matte Non-Tearable Vinyl", "Self-Adhesive Vinyl", "Backlit Film"],
      printMethods: ["High-Speed Solvent & Eco-Solvent", "Latex Odorless Inkjet (Indoor Safe)"],
      options: ["Outdoor Flex Banner", "Roll-Up Pull-Up Standee (6x3 ft / 6x2.5 ft)", "X-Standee", "Glow Sign Board"],
      highlights: [
        { title: "UV & Rain Resilient", desc: "Tough weather-resistant banner material designed to endure sun and downpours." },
        { title: "Reinforced Eyelets & Hems", desc: "Installed with heavy metal grommets every 2 feet for secure tying." },
        { title: "Aluminum Standee Frame", desc: "Roll-up standees come pre-assembled with durable aluminum base & carry bag." }
      ],
      faqs: [
        { q: "Can you help me design the banner?", a: "Yes, our in-house graphic designers can design professional layouts based on your inputs." },
        { q: "How fast can I get a roll-up standee?", a: "We can print, assemble, and dispatch roll-up standees on the same day for urgent exhibitions." }
      ]
    }
  ]

  return categories.map((cat) => ({
    params: { category: cat.slug },
    props: { ...cat }
  }))
}

const {
  slug,
  currentActive,
  title,
  tagline,
  startingPrice,
  minOrder,
  turnaround,
  materials,
  printMethods,
  options,
  highlights,
  faqs
} = Astro.props
---

<Layout 
  title={`${title} - RS Prints`}
  description={tagline}
  canonicalUrl={`/products/${slug}`}
  currentActive={currentActive}
>
  <div class="container mx-auto px-4 py-8 max-w-6xl">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs text-muted-foreground mb-6" aria-label="Breadcrumb">
      <a href="/" class="hover:text-foreground transition-colors">Home</a>
      <span>/</span>
      <a href="/products" class="hover:text-foreground transition-colors">Products</a>
      <span>/</span>
      <span class="text-foreground font-medium">{title}</span>
    </nav>

    <!-- Hero Product Banner -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center rounded-3xl border border-border/70 bg-card/40 p-6 md:p-10 backdrop-blur">
      <div class="lg:col-span-8 space-y-4">
        <div class="inline-flex items-center gap-2 rounded-full border border-primary/20 bg-primary/10 px-3 py-1 text-xs font-semibold text-primary">
          Custom Printing
        </div>
        <h1 class="text-3xl md:text-5xl font-extrabold tracking-tight text-foreground">
          {title}
        </h1>
        <p class="text-base md:text-lg text-muted-foreground leading-relaxed max-w-2xl">
          {tagline}
        </p>

        <!-- Key Quick Specs Pills -->
        <div class="pt-2 flex flex-wrap items-center gap-4 text-xs">
          <div class="rounded-xl border border-border/60 bg-background/80 px-3.5 py-2">
            <span class="text-muted-foreground block text-[11px]">Starting From</span>
            <strong class="text-base text-primary">{startingPrice}</strong>
          </div>
          <div class="rounded-xl border border-border/60 bg-background/80 px-3.5 py-2">
            <span class="text-muted-foreground block text-[11px]">Minimum Order</span>
            <strong class="text-foreground">{minOrder}</strong>
          </div>
          <div class="rounded-xl border border-border/60 bg-background/80 px-3.5 py-2">
            <span class="text-muted-foreground block text-[11px]">Turnaround Time</span>
            <strong class="text-foreground">{turnaround}</strong>
          </div>
        </div>

        <div class="pt-4 flex flex-wrap items-center gap-3">
          <a 
            href="/contact" 
            class="inline-flex items-center justify-center rounded-xl bg-primary px-6 py-3 text-sm font-semibold text-primary-foreground shadow-md transition-colors hover:bg-primary/90"
          >
            Inquire / Order Now
          </a>
          <a 
            href="/products" 
            class="inline-flex items-center justify-center rounded-xl border border-border bg-background px-5 py-3 text-sm font-semibold text-foreground transition-colors hover:bg-muted"
          >
            ← View All Categories
          </a>
        </div>
      </div>

      <!-- Quick Info Box -->
      <div class="lg:col-span-4 rounded-2xl border border-border/80 bg-background/70 p-6 space-y-4">
        <h3 class="font-bold text-sm text-foreground uppercase tracking-wider text-muted-foreground">
          Why Order With Us?
        </h3>
        <ul class="space-y-3 text-xs text-muted-foreground">
          <li class="flex items-start gap-2.5">
            <span class="text-primary font-bold mt-0.5">✦</span>
            <span><strong>Digital Proofs:</strong> We preview mockups before proceeding with physical printing.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="text-primary font-bold mt-0.5">✦</span>
            <span><strong>Bulk Discounts:</strong> Up to 40% discount on institutional and volume orders.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="text-primary font-bold mt-0.5">✦</span>
            <span><strong>Secure Dispatch:</strong> Shock-cushioned bubble packing with live tracking.</span>
          </li>
        </ul>
      </div>
    </div>

    <!-- Highlights Section -->
    <div class="mt-12">
      <h2 class="text-xl md:text-2xl font-bold tracking-tight text-foreground mb-6">
        Key Advantages & Features
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {highlights.map((item) => (
          <div class="rounded-2xl border border-border/60 bg-card/40 p-6 space-y-2 hover:border-primary/40 transition-colors">
            <div class="text-primary font-bold text-base">✦ {item.title}</div>
            <p class="text-sm text-muted-foreground leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- Specifications Grid -->
    <div class="mt-12 grid grid-cols-1 md:grid-cols-3 gap-6">
      <!-- Materials -->
      <div class="rounded-2xl border border-border/60 bg-card/40 p-6 space-y-3">
        <h3 class="text-sm font-bold uppercase tracking-wider text-muted-foreground">Available Materials</h3>
        <ul class="space-y-2">
          {materials.map((m) => (
            <li class="flex items-center gap-2 text-xs text-foreground">
              <span class="text-primary font-bold">•</span>
              {m}
            </li>
          ))}
        </ul>
      </div>

      <!-- Printing Methods -->
      <div class="rounded-2xl border border-border/60 bg-card/40 p-6 space-y-3">
        <h3 class="text-sm font-bold uppercase tracking-wider text-muted-foreground">Print Technologies</h3>
        <ul class="space-y-2">
          {printMethods.map((p) => (
            <li class="flex items-center gap-2 text-xs text-foreground">
              <span class="text-primary font-bold">•</span>
              {p}
            </li>
          ))}
        </ul>
      </div>

      <!-- Varieties / Options -->
      <div class="rounded-2xl border border-border/60 bg-card/40 p-6 space-y-3">
        <h3 class="text-sm font-bold uppercase tracking-wider text-muted-foreground">Sizes & Options</h3>
        <ul class="space-y-2">
          {options.map((o) => (
            <li class="flex items-center gap-2 text-xs text-foreground">
              <span class="text-primary font-bold">•</span>
              {o}
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- How It Works -->
    <div class="mt-14 rounded-3xl border border-border/60 bg-card/20 p-8">
      <h2 class="text-xl md:text-2xl font-bold tracking-tight text-foreground text-center mb-8">
        How To Order in 3 Simple Steps
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-center">
        <div class="space-y-2 p-4">
          <div class="mx-auto flex h-10 w-10 items-center justify-center rounded-full bg-primary/10 text-primary font-bold text-sm">
            1
          </div>
          <h4 class="font-bold text-base text-foreground">Share Your Requirement</h4>
          <p class="text-xs text-muted-foreground leading-relaxed">
            Send us your photo, graphic, logo, or design ideas with your required quantity.
          </p>
        </div>
        <div class="space-y-2 p-4">
          <div class="mx-auto flex h-10 w-10 items-center justify-center rounded-full bg-primary/10 text-primary font-bold text-sm">
            2
          </div>
          <h4 class="font-bold text-base text-foreground">Approve Digital Proof</h4>
          <p class="text-xs text-muted-foreground leading-relaxed">
            Our design team generates a 3D digital mockup for your review and satisfaction.
          </p>
        </div>
        <div class="space-y-2 p-4">
          <div class="mx-auto flex h-10 w-10 items-center justify-center rounded-full bg-primary/10 text-primary font-bold text-sm">
            3
          </div>
          <h4 class="font-bold text-base text-foreground">Print & Fast Dispatch</h4>
          <p class="text-xs text-muted-foreground leading-relaxed">
            We precision-print with premium equipment and carefully package for delivery.
          </p>
        </div>
      </div>
    </div>

    <!-- FAQs -->
    <div class="mt-14 space-y-6">
      <h2 class="text-xl md:text-2xl font-bold tracking-tight text-foreground">
        Frequently Asked Questions
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {faqs.map((faq) => (
          <div class="rounded-2xl border border-border/60 bg-card/40 p-5 space-y-2">
            <h4 class="text-sm font-semibold text-foreground">{faq.q}</h4>
            <p class="text-xs text-muted-foreground leading-relaxed">{faq.a}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- Ready To Order CTA -->
    <div class="mt-14 rounded-3xl border border-primary/20 bg-gradient-to-r from-primary/10 to-primary/5 p-8 text-center space-y-4">
      <h3 class="text-2xl font-bold tracking-tight text-foreground">Ready to create custom {title.toLowerCase()}?</h3>
      <p class="text-sm text-muted-foreground max-w-md mx-auto">
        Contact our team with your artwork or ideas for free mockups and instant quotes.
      </p>
      <div class="pt-2">
        <a 
          href="/contact" 
          class="inline-flex items-center justify-center rounded-xl bg-primary px-6 py-2.5 text-sm font-semibold text-primary-foreground shadow transition-colors hover:bg-primary/90"
        >
          Contact Us for Order & Inquiries
        </a>
      </div>
    </div>
  </div>
</Layout>
