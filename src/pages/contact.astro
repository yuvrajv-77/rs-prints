---
import Layout from "@/layouts/main.astro";
import brandConfig from "@/data/brandConfig.json";

const { brand, contact } = brandConfig;
---

<Layout 
  title={`Contact Us - ${brand.name}`}
  description={`Get in touch with ${brand.name}. Direct contact numbers, WhatsApp support, and customer care emails for custom print orders, design proofs, and bulk inquiries.`}
  canonicalUrl="/contact"
>
  <div class="container mx-auto px-4 py-10 md:py-14 max-w-4xl flex-1 flex flex-col gap-8 md:gap-10">
    <!-- Header banner -->
    <div class="text-center space-y-3 max-w-2xl mx-auto">
      <h1 class="text-3xl md:text-4xl font-heading font-bold tracking-tight text-foreground">
        Contact Us
      </h1>
      <p class="text-sm md:text-base text-muted-foreground leading-relaxed">
        Need assistance with an existing order, custom print artwork, or a bulk quotation? Reach our team directly via phone, WhatsApp, or email.
      </p>
    </div>

    <!-- Pure Contact Details Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      
      <!-- Card 1: Phone & WhatsApp -->
      <div class="rounded-2xl border border-border/80 bg-card p-6 md:p-8 flex flex-col justify-between gap-6 transition-all hover:border-primary/40 hover:shadow-xs">
        <div class="space-y-4">
          <div class="size-12 rounded-xl bg-primary/10 text-primary flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
            </svg>
          </div>
          <div class="space-y-1.5">
            <h2 class="text-lg md:text-xl font-heading font-bold text-foreground">
              Phone & WhatsApp
            </h2>
            <p class="text-sm text-muted-foreground leading-relaxed">
              Instant assistance for order status, urgent inquiries, and artwork proof approvals.
            </p>
          </div>
          <div class="space-y-2 pt-2">
            <div>
              <div class="text-xs md:text-sm font-semibold uppercase tracking-wider text-muted-foreground">
                Support Hotline
              </div>
              <a href={`tel:${contact.phone.raw}`} class="text-lg md:text-xl font-bold text-foreground hover:text-primary font-mono transition-colors block mt-0.5">
                {contact.phone.display}
              </a>
            </div>
            <div class="text-sm text-muted-foreground">
              Available {contact.hours.short}
            </div>
          </div>
        </div>

        <div class="flex flex-col sm:flex-row gap-2.5 pt-4 border-t border-border/40">
          <a
            href={contact.whatsapp.url}
            target="_blank"
            rel="noopener noreferrer"
            class="flex-1 inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-medium transition-colors shadow-xs"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="size-4" viewBox="0 0 24 24" fill="currentColor">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
            </svg>
            Chat on WhatsApp
          </a>
          <a
            href={`tel:${contact.phone.raw}`}
            class="inline-flex items-center justify-center gap-1.5 px-4 py-2.5 rounded-xl border border-border bg-background hover:bg-muted text-foreground text-sm font-medium transition-colors"
          >
            Call Now
          </a>
        </div>
      </div>

      <!-- Card 2: Email & Support Inquiries -->
      <div class="rounded-2xl border border-border/80 bg-card p-6 md:p-8 flex flex-col justify-between gap-6 transition-all hover:border-primary/40 hover:shadow-xs">
        <div class="space-y-4">
          <div class="size-12 rounded-xl bg-primary/10 text-primary flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="20" height="16" x="2" y="4" rx="2"/>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
            </svg>
          </div>
          <div class="space-y-1.5">
            <h2 class="text-lg md:text-xl font-heading font-bold text-foreground">
              Email Support
            </h2>
            <p class="text-sm text-muted-foreground leading-relaxed">
              Send your design print files, artwork revisions, and corporate inquiries.
            </p>
          </div>
          <div class="space-y-3 pt-2">
            <div>
              <div class="text-xs md:text-sm font-semibold uppercase tracking-wider text-muted-foreground">
                General & Orders
              </div>
              <a href={`mailto:${contact.email.support}`} class="text-sm md:text-base font-semibold text-primary hover:underline font-mono block mt-0.5">
                {contact.email.support}
              </a>
            </div>
            <div>
              <div class="text-xs md:text-sm font-semibold uppercase tracking-wider text-muted-foreground">
                Corporate & Bulk Printing
              </div>
              <a href={`mailto:${contact.email.bulk}`} class="text-sm md:text-base font-semibold text-primary hover:underline font-mono block mt-0.5">
                {contact.email.bulk}
              </a>
            </div>
          </div>
        </div>

        <div class="pt-4 border-t border-border/40">
          <a
            href={`mailto:${contact.email.support}?subject=Print%20Inquiry%20-%20${encodeURIComponent(brand.name)}`}
            class="w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-secondary hover:bg-secondary/80 text-secondary-foreground text-sm font-medium transition-colors"
          >
            Compose Email
            <svg xmlns="http://www.w3.org/2000/svg" class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M7 7h10v10"/>
              <path d="M7 17 17 7"/>
            </svg>
          </a>
        </div>
      </div>

    </div>

    <!-- Operating Hours & Quick Navigation -->
    <div class="rounded-2xl border border-border/60 bg-muted/30 p-6 md:p-8 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
      <div class="space-y-2 max-w-xl">
        <div class="text-xs md:text-sm font-semibold uppercase tracking-wider text-muted-foreground flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="size-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/>
            <polyline points="12 6 12 12 16 14"/>
          </svg>
          Working Hours & Response Time
        </div>
        <h3 class="text-base md:text-lg font-heading font-bold text-foreground">
          Fast response {contact.hours.responseTime.toLowerCase()}
        </h3>
        <p class="text-sm text-muted-foreground leading-relaxed">
          For urgent digital proof approvals and dispatch inquiries, please connect via WhatsApp or Phone for immediate assistance.
        </p>
      </div>

      <div class="flex flex-col sm:flex-row gap-3 w-full md:w-auto shrink-0">
        <a
          href="/faq"
          class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl border border-border bg-background hover:bg-muted text-sm font-medium text-foreground transition-colors"
        >
          Check FAQs
        </a>
        <a
          href="/shipping-and-refund-policy"
          class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-xl bg-primary text-primary-foreground text-sm font-medium shadow-xs hover:brightness-105 transition-all"
        >
          Shipping & Returns
        </a>
      </div>
    </div>
  </div>
</Layout>
