---
import Layout from "@/layouts/main.astro";
---

<Layout 
  title="404 - Page Not Found | RS Prints"
  description="The requested page could not be found. Return to RS Prints for custom printing, personalized photo frames, and customized apparel."
  canonicalUrl="/404"
>
  <main class="container mx-auto px-4 py-16 md:py-28 flex-1 flex flex-col items-center justify-center text-center">
    <div class="relative max-w-xl w-full flex flex-col items-center">
      
      <!-- CMYK / Print-inspired Color Bars -->
      <div class="flex items-center gap-1.5 mb-6 opacity-85">
        <span class="w-8 h-2 rounded-full bg-cyan-400" title="Cyan"></span>
        <span class="w-8 h-2 rounded-full bg-pink-500" title="Magenta"></span>
        <span class="w-8 h-2 rounded-full bg-yellow-400" title="Yellow"></span>
        <span class="w-8 h-2 rounded-full bg-foreground" title="Key/Black"></span>
      </div>

      <!-- Giant 404 Display -->
      <div class="select-none my-2">
        <span class="text-8xl sm:text-9xl md:text-[11rem] font-heading font-extrabold tracking-tighter text-foreground/20 dark:text-foreground/10 leading-none">
          404
        </span>
      </div>

      <!-- Headings & Explanations -->
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-heading font-bold text-foreground mt-2 tracking-tight">
        Oops! This Page Ran Off The Press
      </h1>
      <p class="text-sm sm:text-base text-muted-foreground mt-3 max-w-md mx-auto leading-relaxed">
        The design or page you're searching for might have been moved, renamed, or never made it onto our printing line.
      </p>

      <!-- Primary Action Buttons -->
      <div class="flex flex-wrap items-center justify-center gap-3 mt-8">
        <a 
          href="/" 
          class="inline-flex items-center justify-center gap-2 h-11 px-6 rounded-xl bg-primary text-primary-foreground font-semibold shadow-sm hover:brightness-105 transition-all active:scale-[0.98]"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
            <polyline points="9 22 9 12 15 12 15 22"/>
          </svg>
          Back to Homepage
        </a>
        <a 
          href="/products/photo-frame" 
          class="inline-flex items-center justify-center gap-2 h-11 px-6 rounded-xl border border-border bg-card hover:bg-muted/70 text-foreground font-medium transition-all active:scale-[0.98]"
        >
          Explore Products
        </a>
      </div>

    </div>
  </main>
</Layout>
