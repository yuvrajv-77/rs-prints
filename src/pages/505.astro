---
import Layout from "@/layouts/main.astro";
---

<Layout 
  title="505 - Server Error | RS Prints"
  description="Our printing press hit an unexpected snag. We are working hard to get production back on track."
  canonicalUrl="/505"
>
  <main class="container mx-auto px-4 py-16 md:py-24 flex-1 flex flex-col items-center justify-center text-center">
    <div class="relative max-w-2xl w-full flex flex-col items-center">
      
      <!-- Warning Status Pill -->
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-destructive/10 border border-destructive/30 text-destructive text-xs sm:text-sm font-semibold mb-4">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/>
          <line x1="12" y1="9" x2="12" y2="13"/>
          <line x1="12" y1="17" x2="12.01" y2="17"/>
        </svg>
        Status 505: Server Protocol Error
      </div>

      <!-- Giant 505 Display -->
      <div class="relative select-none my-2">
        <span class="text-8xl sm:text-9xl md:text-[11rem] font-heading font-extrabold tracking-tighter text-destructive/15 leading-none">
          505
        </span>
      </div>

      <!-- Headings & Explanations -->
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-heading font-bold text-foreground mt-2 tracking-tight">
        Print Press Jammed!
      </h1>
      <p class="text-sm sm:text-base text-muted-foreground mt-3 max-w-md mx-auto leading-relaxed">
        Our printing servers encountered an unexpected protocol or communication snag. Our technical team has been alerted and is clearing the line.
      </p>

      <!-- Action Buttons -->
      <div class="flex flex-wrap items-center justify-center gap-3 mt-8">
        <button 
          id="reload-btn-505" 
          class="inline-flex items-center justify-center gap-2 h-11 px-6 rounded-xl bg-primary text-primary-foreground font-semibold shadow-sm hover:brightness-105 transition-all active:scale-[0.98] cursor-pointer"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/>
            <path d="M3 3v5h5"/>
            <path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16"/>
            <path d="M16 21h5v-5"/>
          </svg>
          Reload Page
        </button>
        <a 
          href="/" 
          class="inline-flex items-center justify-center gap-2 h-11 px-6 rounded-xl border border-border bg-card hover:bg-muted/70 text-foreground font-medium transition-all active:scale-[0.98]"
        >
          Return to Home
        </a>
        <a 
          href="/contact" 
          class="inline-flex items-center justify-center gap-2 h-11 px-6 rounded-xl border border-border bg-card hover:bg-muted/70 text-foreground font-medium transition-all active:scale-[0.98]"
        >
          Contact Support
        </a>
      </div>

      <!-- Diagnostic Status Card -->
      <div class="w-full mt-10 p-5 rounded-2xl border border-border bg-card/60 backdrop-blur-xs text-left">
        <div class="flex items-center justify-between text-xs text-muted-foreground mb-2">
          <span class="font-mono font-semibold">Incident: ERR_HTTP_VERSION_OR_TIMEOUT</span>
          <span class="inline-flex items-center gap-1.5 text-emerald-600 dark:text-emerald-400 font-medium">
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            Automatic Recovery Active
          </span>
        </div>
        <p class="text-xs text-muted-foreground leading-relaxed">
          Your cart items, design uploads, and pending orders are securely preserved. Please try reloading in a moment or reach out to our support desk.
        </p>
      </div>

    </div>
  </main>

  <script>
    document.getElementById("reload-btn-505")?.addEventListener("click", () => {
      window.location.reload();
    });
  </script>
</Layout>
