# ==============================================================================
# RS Prints - Vendure Server Environment Variables (.env.example)
# ==============================================================================
# Copy this file to .env and replace placeholder values with your real configuration.
# Run: cp .env.example .env (Linux/macOS) or copy .env.example .env (Windows)
# ==============================================================================

# Application Environment ('dev' enables debug modes, graphiql, and open CORS)
APP_ENV=dev

# Server Port
VENDURE_SERVER_PORT=3000
# PORT=3000 # Optional: Cloud providers (e.g. Render, Railway) inject PORT automatically

# Session & Cookie Secret (generate a secure random 32+ character string)
COOKIE_SECRET=replace_with_a_secure_random_cookie_secret_key

# Superadmin Initial Credentials
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=superadmin

# Comma-separated list of browser origins allowed to make credentialed API requests.
# Only required when APP_ENV is not "dev". In dev mode, CORS allows any origin.
# Example: https://rsprints.pages.dev,http://localhost:4321
CORS_ORIGINS=

# ------------------------------------------------------------------------------
# Database Configuration (PostgreSQL)
# ------------------------------------------------------------------------------
# Option 1: Connection string (recommended for Neon Serverless or Cloud Postgres)
DATABASE_URL=postgresql://username:password@ep-xyz-123.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Option 2: Individual connection parameters (alternative for local Docker / Postgres)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=vendure
# DB_USERNAME=postgres
# DB_PASSWORD=postgres
# DB_SSL=false

# Database schema name (defaults to 'public')
DB_SCHEMA=public

# Automatically synchronize database schema on server startup
# Set to 'true' for local development / new database setup; set to 'false' in production with migrations
DB_SYNCHRONIZE=true

# ------------------------------------------------------------------------------
# Object Storage (S3 / Neon S3 / Cloudflare R2 / AWS S3)
# ------------------------------------------------------------------------------
# Endpoint for S3-compatible storage (omit or leave empty for standard AWS S3)
AWS_ENDPOINT_URL_S3="https://example-storage.aws.neon.tech"
AWS_ACCESS_KEY_ID="your_s3_access_key_id"
AWS_SECRET_ACCESS_KEY="your_s3_secret_access_key"
AWS_REGION="ap-southeast-1"
AWS_BUCKET_NAME="rs-assets"

# ------------------------------------------------------------------------------
# Payment Gateway (Razorpay)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID="rzp_test_your_razorpay_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"

