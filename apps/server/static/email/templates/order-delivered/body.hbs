{{> header title="Your Order Has Been Delivered!" }}

<mj-section background-color="#ffffff" padding="32px 24px 20px">
    <mj-column>
        <!-- Status Badge -->
        <mj-text align="center" padding="0 0 12px 0">
            <span style="display: inline-block; background-color: #ecfdf5; color: #059669; border: 1px solid #a7f3d0; border-radius: 9999px; padding: 6px 16px; font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px;">
                🎉 Order Delivered Successfully
            </span>
        </mj-text>

        <mj-text align="center" font-size="26px" font-weight="800" color="#0f172a" font-family="Helvetica, Arial, sans-serif" padding="0 0 8px 0">
            Package Delivered!
        </mj-text>

        <mj-text align="center" font-size="14px" color="#64748b" font-family="Helvetica, Arial, sans-serif" padding="0 0 24px 0">
            Order Reference: <strong style="color: #0f172a; font-family: monospace; font-size: 16px;">#{{ order.code }}</strong>
        </mj-text>

        <mj-text font-size="15px" color="#334155" line-height="24px" font-family="Helvetica, Arial, sans-serif" padding="0 0 20px 0">
            Hi <strong>{{ order.customer.firstName }}</strong>, your RS Prints package has been successfully delivered! We hope you love your newly printed custom merchandise as much as we loved crafting it for you.
        </mj-text>
    </mj-column>
</mj-section>

<!-- Delivery Summary Card -->
<mj-section background-color="#f8fafc" border-radius="12px" padding="20px 24px" border="1px solid #e2e8f0">
    <mj-column width="50%" padding="0 10px 10px 0">
        <mj-text font-size="12px" font-weight="700" color="#64748b" text-transform="uppercase" letter-spacing="0.5px" padding="0 0 6px 0">
            Delivered To
        </mj-text>
        <mj-text font-size="14px" color="#1e293b" line-height="22px" padding="0">
            {{#with order.shippingAddress }}
                <strong>{{ fullName }}</strong><br/>
                {{ streetLine1 }}<br/>
                {{#if streetLine2}}{{ streetLine2 }}<br/>{{/if}}
                {{ city }}, {{ province }} - {{ postalCode }}<br/>
                {{#if phoneNumber}}Phone: <strong>{{ phoneNumber }}</strong>{{/if}}
            {{/with}}
        </mj-text>
    </mj-column>

    <mj-column width="50%" padding="0 0 10px 10px">
        <mj-text font-size="12px" font-weight="700" color="#64748b" text-transform="uppercase" letter-spacing="0.5px" padding="0 0 6px 0">
            Delivery Summary
        </mj-text>
        <mj-text font-size="14px" color="#1e293b" line-height="22px" padding="0">
            <strong>Order Code:</strong> #{{ order.code }}<br/>
            {{#if fulfillment.method}}<strong>Delivered Via:</strong> {{ fulfillment.method }}<br/>{{/if}}
            {{#if fulfillment.trackingCode}}<strong>Tracking ID:</strong> {{ fulfillment.trackingCode }}<br/>{{/if}}
            <strong>Status:</strong> Delivered<br/>
            <strong>Satisfaction Guarantee:</strong> 100% Quality Checked<br/>
            <strong>Need Assistance?</strong> Instant WhatsApp Support
        </mj-text>
    </mj-column>
</mj-section>

<!-- Itemized Delivered Items -->
<mj-section background-color="#ffffff" padding="28px 24px 10px">
    <mj-column>
        <mj-text font-size="16px" font-weight="700" color="#0f172a" font-family="Helvetica, Arial, sans-serif" padding="0 0 12px 0">
            Items in this Package
        </mj-text>
        <mj-divider border-width="1px" border-color="#e2e8f0" padding="0 0 16px 0" />

        <mj-table cellpadding="8px">
            {{#each order.lines }}
                <tr style="border-bottom: 1px solid #f1f5f9;">
                    <td style="width: 60px; vertical-align: middle; padding: 10px 8px 10px 0;">
                        {{#if featuredAsset}}
                            <img alt="{{ productVariant.name }}"
                                 style="width: 56px; height: 56px; border-radius: 8px; object-fit: cover; border: 1px solid #e2e8f0; display: block;"
                                 src="{{ featuredAsset.preview }}?w=56&h=56" />
                        {{else}}
                            <div style="width: 56px; height: 56px; border-radius: 8px; background-color: #f1f5f9; display: flex; align-items: center; justify-content: center; font-size: 10px; color: #94a3b8;">
                                RS Prints
                            </div>
                        {{/if}}
                    </td>
                    <td style="vertical-align: middle; padding: 10px 8px;">
                        <span style="font-size: 14px; font-weight: 600; color: #0f172a; display: block; line-height: 18px;">
                            {{ productVariant.name }}
                        </span>
                        <span style="font-size: 12px; color: #64748b; display: block; margin-top: 4px;">
                            Delivered Quantity: <strong>{{ quantity }}</strong>
                        </span>
                    </td>
                    <td style="text-align: right; vertical-align: middle; font-size: 14px; font-weight: 700; color: #0f172a; padding: 10px 0 10px 8px;">
                        {{ formatMoney discountedLinePriceWithTax ../order.currencyCode 'en' }}
                    </td>
                </tr>
            {{/each}}
        </mj-table>
    </mj-column>
</mj-section>

<!-- Action Buttons -->
<mj-section background-color="#ffffff" padding="10px 24px 30px">
    <mj-column>
        <mj-button font-family="Helvetica, Arial, sans-serif"
                   background-color="#059669"
                   color="#ffffff"
                   font-weight="bold"
                   font-size="15px"
                   border-radius="8px"
                   inner-padding="14px 28px"
                   href="{{ storefrontUrl }}/checkout/success?code={{ order.code }}">
            View Order Receipt & Details &rarr;
        </mj-button>

        <mj-spacer height="16px" />

        <mj-text align="center" font-size="13px" color="#64748b" line-height="20px" padding="0">
            If anything about your custom print isn't 100% perfect, our support desk is ready to make it right. 
            Reply directly to this email or message us on WhatsApp at 
            <a href="https://wa.me/919876543210?text=Hi%20RS%20Prints,%20regarding%20delivered%20Order%20#{{ order.code }}" style="color: #059669; font-weight: bold; text-decoration: underline;">+91 98765 43210</a>.
        </mj-text>
    </mj-column>
</mj-section>

{{> footer }}
