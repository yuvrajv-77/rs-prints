# ==============================================================================
# RS Prints - Storefront Environment Variables (.env.example)
# ==============================================================================
# Copy this file to .env and replace placeholder values with your configuration.
# Run: cp .env.example .env (Linux/macOS) or copy .env.example .env (Windows)
# ==============================================================================

# Public Vendure Shop GraphQL API endpoint
PUBLIC_VENDURE_API_URL=http://localhost:3000/shop-api

# Public Razorpay Key ID for client-side checkout integration
PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id

