---
import type { CatalogParentCategory } from "@/lib/catalog"
import { ArrowRight, ChevronRight, Layers } from "lucide-react"

interface Props {
  category: CatalogParentCategory
}

const { category } = Astro.props
---

<div class="group flex flex-col rounded-2xl border border-border/70 bg-card overflow-hidden shadow-xs hover:border-primary/50 hover:shadow-md transition-all duration-200">
  <!-- Card Visual Header -->
  <a
    href={`/categories/${category.id}`}
    data-astro-prefetch="hover"
    class="relative aspect-16/9 sm:aspect-2/1 w-full overflow-hidden bg-muted block"
  >
    <img
      src={category.image}
      alt={category.title}
      class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-linear-to-t from-black/70 via-black/20 to-transparent" />

    <!-- Badges -->
    <div class="absolute top-3 left-3">
      <span class="inline-flex items-center gap-1.5 rounded-full bg-background/90 backdrop-blur-md px-2.5 py-1 text-xs font-semibold text-foreground border border-border/60 shadow-xs">
        <Layers className="size-3 text-primary" />
        <span>{category.subcategories.length} Collections</span>
      </span>
    </div>

    <div class="absolute bottom-3 left-3 right-3 flex items-end justify-between text-white">
      <div>
        <h2 class="font-heading text-lg sm:text-xl font-bold tracking-tight drop-shadow-xs">
          {category.title}
        </h2>
        <span class="text-xs text-white/80 font-mono">
          {category.totalCount} Products
        </span>
      </div>
    </div>
  </a>

  <!-- Card Body -->
  <div class="flex flex-col flex-1 justify-between p-4 sm:p-5 space-y-4">
    <p class="text-xs sm:text-sm text-muted-foreground line-clamp-2 leading-relaxed">
      {category.description}
    </p>

    <!-- Subcategories List Chips -->
    {category.subcategories && category.subcategories.length > 0 && (
      <div class="space-y-2 pt-2 border-t border-border/50">
        <span class="text-[11px] font-semibold uppercase tracking-wider text-muted-foreground block">
          Collections:
        </span>
        <div class="flex flex-wrap gap-1.5">
          {category.subcategories.map((sub) => (
            <a
              href={`/categories/${category.id}/${sub.id}`}
              data-astro-prefetch="hover"
              class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-xs bg-muted/60 hover:bg-primary/10 hover:text-primary transition-colors border border-border/40 text-foreground/80"
            >
              <span>{sub.title}</span>
              <span class="text-[10px] font-mono text-muted-foreground">({sub.count})</span>
            </a>
          ))}
        </div>
      </div>
    )}

    <!-- Card Action Link -->
    <div class="pt-3">
      <a
        href={`/categories/${category.id}`}
        data-astro-prefetch="hover"
        class="inline-flex items-center justify-between w-full px-4 py-2.5 rounded-xl bg-primary/10 hover:bg-primary text-primary hover:text-primary-foreground text-xs sm:text-sm font-semibold transition-all duration-150"
      >
        <span>Explore All {category.title}</span>
        <ArrowRight className="size-4" />
      </a>
    </div>
  </div>
</div>
