---
interface SubcategoryPill {
  id: string
  title: string
  href: string
  count: number
  isActive: boolean
}

interface Props {
  parentSlug: string
  parentTitle: string
  parentCount: number
  subcategories: {
    id: string
    title: string
    count: number
  }[]
  currentActiveSlug?: string // if empty or 'all', parent is active
}

const { parentSlug, parentTitle, parentCount, subcategories, currentActiveSlug = "all" } = Astro.props

const isAllActive = currentActiveSlug === "all" || !currentActiveSlug || currentActiveSlug === parentSlug

const pills: SubcategoryPill[] = [
  {
    id: "all",
    title: `All ${parentTitle}`,
    href: `/categories/${parentSlug}`,
    count: parentCount,
    isActive: isAllActive,
  },
  ...subcategories.map((sub) => ({
    id: sub.id,
    title: sub.title,
    href: `/categories/${parentSlug}/${sub.id}`,
    count: sub.count,
    isActive: currentActiveSlug.toLowerCase() === sub.id.toLowerCase(),
  })),
]
---

<div class="sticky top-16 z-20 -mx-4 px-4 sm:mx-0 sm:px-0 py-3 bg-background/95 backdrop-blur-md border-b border-border/50">
  <div class="flex items-center gap-2 overflow-x-auto scrollbar-none snap-x snap-mandatory py-0.5">
    {pills.map((pill) => (
      <a
        href={pill.href}
        data-astro-prefetch="hover"
        class={`snap-start shrink-0 inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold transition-all duration-150 border ${
          pill.isActive
            ? "bg-primary text-primary-foreground border-primary shadow-xs"
            : "bg-card text-foreground/85 hover:text-foreground hover:bg-muted/70 border-border/70"
        }`}
      >
        <span>{pill.title}</span>
        <span
          class={`text-[11px] font-mono px-1.5 py-0.2 rounded-full ${
            pill.isActive
              ? "bg-primary-foreground/20 text-primary-foreground"
              : "bg-muted text-muted-foreground"
          }`}
        >
          {pill.count}
        </span>
      </a>
    ))}
  </div>
</div>
