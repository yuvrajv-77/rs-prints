---
import type { Product } from "@/types/product"
import MinimalProductCard from "@/components/product/MinimalProductCard.astro"
import { ArrowRight } from "lucide-react"

interface Props {
  products: Product[]
  categorySlug?: string
  parentCategorySlug?: string
  collectionTitle?: string
  viewAllHref?: string
}

const {
  products,
  categorySlug = "",
  parentCategorySlug = "",
  collectionTitle = "",
  viewAllHref = "/categories",
} = Astro.props
---

{products && products.length > 0 && (
  <section class="mt-16 sm:mt-20 space-y-6 border-t border-border/60 pt-10 sm:pt-12">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3">
      <div>
        <div class="text-xs font-semibold uppercase tracking-wider text-primary mb-1">
          Related Products
        </div>
        <h2 class="text-xl sm:text-2xl md:text-3xl font-heading font-bold text-foreground tracking-tight">
          {collectionTitle ? `More in ${collectionTitle}` : "Frequently Customized Together"}
        </h2>
        <p class="text-xs sm:text-sm text-muted-foreground mt-1">
          Complementary merchandise and personalized printing solutions from the same collection.
        </p>
      </div>

      {viewAllHref && (
        <a
          href={viewAllHref}
          class="text-xs sm:text-sm font-semibold text-primary hover:underline inline-flex items-center gap-1 self-start sm:self-auto"
        >
          <span>View all {collectionTitle || "items"}</span>
          <ArrowRight className="size-3.5" />
        </a>
      )}
    </div>

    <!-- Responsive Cards Grid using Reusable MinimalProductCard Component -->
    <div class="grid grid-cols-2 sm:grid-cols-2 md:grid-cols-4 gap-3.5 sm:gap-5">
      {products.map((item) => (
        <MinimalProductCard
          product={item}
          parentCategorySlug={parentCategorySlug}
          categorySlug={categorySlug || (item.category ? item.category.toLowerCase().replace(/\s+/g, "-") : "")}
        />
      ))}
    </div>
  </section>
)}
