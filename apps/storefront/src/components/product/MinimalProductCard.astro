---
import type { Product } from "@/types/product"
import { Clock, ChevronRight, ShoppingBag } from "lucide-react"

interface Props {
  product: Product
  categorySlug: string
  parentCategorySlug?: string
  className?: string
}

const { product, categorySlug, parentCategorySlug = "", className = "" } = Astro.props

// Category-based fallback imagery when products don't have custom uploaded images
const categoryFallbackImages: Record<string, string> = {
  "ceramic-mug": "https://images.unsplash.com/photo-1514432324607-a09d9b4aefdd?auto=format&fit=crop&w=800&q=80",
  "glass-mug": "https://images.unsplash.com/photo-1577937927133-66ef06acdf18?auto=format&fit=crop&w=800&q=80",
  "glass-mug-tumbler": "https://images.unsplash.com/photo-1577937927133-66ef06acdf18?auto=format&fit=crop&w=800&q=80",
  "aluminium-water-bottle": "https://images.unsplash.com/photo-1602143407151-7111542de6e8?auto=format&fit=crop&w=800&q=80",
  "stainless-steel-drinkware": "https://images.unsplash.com/photo-1589365278144-c9e705f843ba?auto=format&fit=crop&w=800&q=80",
  "kids-water-bottle": "https://images.unsplash.com/photo-1602143407151-7111542de6e8?auto=format&fit=crop&w=800&q=80",
  "fur-pillow": "https://images.unsplash.com/photo-1584100936595-c0654b55a2e2?auto=format&fit=crop&w=800&q=80",
  "flip-sequin-pillow-cover": "https://images.unsplash.com/photo-1584100936595-c0654b55a2e2?auto=format&fit=crop&w=800&q=80",
  "mdf-collage-frame": "https://images.unsplash.com/photo-1544457070-4cd773b4d71e?auto=format&fit=crop&w=800&q=80",
  "sublimation-glass-frame": "https://images.unsplash.com/photo-1513519245088-0e12902e5a38?auto=format&fit=crop&w=800&q=80",
  "stone-frame": "https://images.unsplash.com/photo-1582738411706-bfc8e691d1c2?auto=format&fit=crop&w=800&q=80",
  "mdf-products": "https://images.unsplash.com/photo-1513519245088-0e12902e5a38?auto=format&fit=crop&w=800&q=80",
  "hard-board": "https://images.unsplash.com/photo-1563861826100-9cb868fdbe1c?auto=format&fit=crop&w=800&q=80",
  "sublimation-products": "https://images.unsplash.com/photo-1616440347437-b1c73416efc2?auto=format&fit=crop&w=800&q=80",
  "t-shirt": "https://images.unsplash.com/photo-1521572267360-ee0c2909d518?auto=format&fit=crop&w=800&q=80",
  "tote-bag": "https://images.unsplash.com/photo-1544816155-12df9643f363?auto=format&fit=crop&w=800&q=80"
}

const displayImageUrl = (product.images && product.images[0]?.url) || categoryFallbackImages[categorySlug]
---

<a
  href={`/products/${product.slug}`}
  data-product-slug={product.slug}
  data-category-slug={categorySlug}
  data-subcategory={categorySlug}
  data-parent-category={parentCategorySlug || categorySlug}
  data-product-title={product.title}
  class={`group relative flex flex-col rounded-2xl border border-border/70 bg-card overflow-hidden transition-all duration-200 hover:-translate-y-1 hover:border-primary/60 hover:shadow-md focus:outline-none focus:ring-2 focus:ring-primary/40 ${className}`}
>
  <!-- Card Image -->
  <div class="relative aspect-square w-full overflow-hidden bg-muted/40">
    {displayImageUrl ? (
      <img
        src={displayImageUrl}
        alt={product.images?.[0]?.alt || product.title}
        class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-106"
        loading="lazy"
      />
    ) : (
      <div class="h-full w-full flex items-center justify-center bg-muted text-muted-foreground">
        <ShoppingBag className="size-8 opacity-40" />
      </div>
    )}

    <!-- Top Badge if available -->
    {product.badge && (
      <div class="absolute top-2.5 left-2.5">
        <span class="rounded-md bg-card/90 backdrop-blur-md px-2 py-0.5 text-[10px] font-semibold text-foreground border border-border/60 shadow-2xs">
          {product.badge}
        </span>
      </div>
    )}

    <!-- Starting Price Chip on Image -->
    <div class="absolute bottom-2.5 right-2.5">
      <span class="rounded-md bg-background/90 backdrop-blur-md px-2 py-0.5 text-[11px] font-mono font-semibold text-foreground border border-border/60 shadow-2xs">
        {product.startingPrice}
      </span>
    </div>
  </div>

  <!-- Card Body -->
  <div class="flex flex-col flex-1 justify-between p-3.5 sm:p-4 space-y-2">
    <div>
      <h3 class="font-heading text-sm sm:text-base font-semibold text-foreground group-hover:text-primary transition-colors leading-snug line-clamp-1">
        {product.title}
      </h3>
      {product.tagline && (
        <p class="text-[11px] sm:text-xs text-muted-foreground line-clamp-1 mt-0.5">
          {product.tagline}
        </p>
      )}
    </div>

    <div class="pt-2 border-t border-border/40 flex items-center justify-between text-[11px]">
      <span class="text-muted-foreground flex items-center gap-1">
        <Clock className="size-3" />
        <span>{product.turnaround}</span>
      </span>
      <span class="font-medium text-primary inline-flex items-center gap-0.5 group-hover:translate-x-0.5 transition-transform">
        Customize <ChevronRight className="size-3" />
      </span>
    </div>
  </div>
</a>
