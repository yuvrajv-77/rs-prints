---
// apps/storefront/src/pages/sample-products.astro
// Live Vendure Sample Products Page demonstrating Collections & Facets
import ProductsLayout from "@/layouts/ProductsLayout.astro"
import MinimalProductCard from "@/components/product/MinimalProductCard.astro"
import { getVendureGroupedSections } from "@/lib/vendure/queries/products"
import { Badge } from "@/components/ui/badge"
import { Filter, Layers, Tag } from "lucide-react"

// Fetch ONLY live products, collections, and facets directly from Vendure database
const { groupedSections, facets, totalProducts } = await getVendureGroupedSections()
---

<ProductsLayout
  title="Live Vendure Products Catalogue - RS Prints"
  description="Explore live items fetched directly from Vendure database with collection groupings and facet attributes."
  canonicalUrl="/sample-products"
  currentActive="sample-products"
  groupedSections={groupedSections}
>
  <div class="space-y-12">
    <!-- Live Vendure Facet Insight Box (Explaining Facets vs Collections) -->
    <div class="rounded-2xl border border-primary/20 bg-primary/5 p-4 sm:p-5 space-y-3.5">
      <div class="flex items-center justify-between flex-wrap gap-2">
        <div class="flex items-center gap-2">
          <div class="p-1.5 rounded-lg bg-primary/10 text-primary">
            <Filter className="size-4" />
          </div>
          <h2 class="text-sm font-bold tracking-tight text-foreground">
            Live Vendure Facets & Attributes ({totalProducts} Products Total)
          </h2>
        </div>
        <span class="text-xs text-muted-foreground font-mono">
          Source: Vendure Shop API
        </span>
      </div>

      <p class="text-xs text-muted-foreground leading-relaxed">
        <strong>How Facets Work:</strong> Collections create your page hierarchy (e.g. <em>Mugs &rarr; Ceramics Mugs</em>). 
        Facets are cross-cutting attributes (e.g. <em>Material</em> or <em>Color</em>) assigned to products so users can filter across any category.
      </p>

      <!-- Active Facets retrieved from Vendure -->
      <div class="flex flex-wrap gap-3 pt-1">
        {facets.map((facet) => (
          <div class="inline-flex items-center gap-1.5 rounded-lg bg-card border border-border px-3 py-1.5 text-xs shadow-xs">
            <Tag className="size-3 text-primary/70" />
            <span class="font-semibold text-foreground">{facet.name}:</span>
            <div class="flex items-center gap-1">
              {facet.values.map((val) => (
                <Badge variant="outline" className="text-[10px] font-mono px-1.5 py-0">
                  {val.name}
                </Badge>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Product Groups (Mapped from Vendure Top-level Collections) -->
    {groupedSections.length === 0 ? (
      <div class="text-center py-16 text-muted-foreground">
        <p>No products found in Vendure. Check that your Vendure server is running and products are published.</p>
      </div>
    ) : (
      groupedSections.map((group) => (
        <div
          id={group.id}
          data-category-section={group.id}
          data-category-title={group.title}
          class="scroll-mt-28 space-y-7 transition-all duration-200"
        >
          <!-- Section Group Header -->
          <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-2 pb-3 border-b border-border/70">
            <div class="space-y-1">
              <div class="flex items-center gap-2">
                <h2 class="font-heading text-xl sm:text-2xl font-bold tracking-tight text-foreground">
                  {group.title}
                </h2>
                <Badge variant="secondary" className="text-[11px] font-mono px-2 py-0.5 ml-1">
                  {group.products.length} {group.products.length === 1 ? "item" : "items"}
                </Badge>
              </div>
              <p class="text-xs sm:text-sm text-muted-foreground max-w-xl">
                {group.description}
              </p>
            </div>

            <a
              href="#top"
              class="text-[11px] text-muted-foreground hover:text-foreground inline-flex items-center gap-1 self-start sm:self-auto transition-colors"
            >
              Back to top &uarr;
            </a>
          </div>

          <!-- Subcategories Content -->
          <div class="space-y-8">
            {group.subcategories.map((sub) => (
              <div
                data-subcategory-section={sub.id}
                data-subcategory-title={sub.title}
                class="space-y-3.5 transition-all duration-200"
              >
                {group.subcategories.length > 1 && (
                  <div class="flex items-center justify-between pt-1">
                    <div class="flex items-center gap-2">
                      <h3 class="text-xs sm:text-sm font-semibold tracking-wide uppercase text-foreground/80">
                        {sub.title}
                      </h3>
                      <span class="text-[11px] text-muted-foreground font-mono">
                        ({sub.products.length})
                      </span>
                    </div>
                  </div>
                )}

                <!-- Minimal Cards Grid using Reusable MinimalProductCard Component -->
                <div class="grid grid-cols-2 sm:grid-cols-2 md:grid-cols-3 xl:grid-cols-3 gap-3.5 sm:gap-4.5">
                  {sub.products.map((item) => (
                    <MinimalProductCard
                      product={item}
                      parentCategorySlug={group.id}
                      categorySlug={sub.id}
                    />
                  ))}
                </div>
              </div>
            ))}
          </div>
        </div>
      ))
    )}
  </div>
</ProductsLayout>
