---
import Layout from "@/layouts/main.astro"
import MinimalProductCard from "@/components/product/MinimalProductCard.astro"
import { getProductBySlug } from "@/data/products"
import { getVendureGroupedSections } from "@/lib/vendure/queries/products"
import brandConfig from "@/data/brandConfig.json"
import {
  Sparkles,
  ArrowRight,
  ArrowUpRight,
  Layers,
  Clock,
  Package,
  ShieldCheck,
  ChevronRight,
  CheckCircle2,
  Palette,
  Truck,
  MessageCircle,
} from "lucide-react"

// Curated popular categories for direct discovery
const popularCategories = [
  {
    title: "Ceramic & Glass Mugs",
    subtitle: "Classic white mugs, patch cups, frosted glass & heart handles",
    price: "From ₹149",
    href: "/products#mugs",
    image: "https://images.unsplash.com/photo-1514432324607-a09d9b4aefdd?auto=format&fit=crop&w=800&q=80",
    badge: "Most Popular",
  },
  {
    title: "Drinkware & Bottles",
    subtitle: "Double-wall stainless steel vacuum flasks & sports sippers",
    price: "From ₹199",
    href: "/products#drinkware",
    image: "https://images.unsplash.com/photo-1602143407151-7111542de6e8?auto=format&fit=crop&w=800&q=80",
    badge: "Trending",
  },
  {
    title: "Photo Frames & Rocks",
    subtitle: "Natural slate stone plaques, wooden collage & beveled glass",
    price: "From ₹199",
    href: "/products#photo-frames",
    image: "https://images.unsplash.com/photo-1582738411706-bfc8e691d1c2?auto=format&fit=crop&w=800&q=80",
    badge: "Gift Ready",
  },
  {
    title: "Pillows & Cushions",
    subtitle: "Interactive reversible magic sequins & ultra-soft plush fur",
    price: "From ₹249",
    href: "/products#pillows-cushions",
    image: "https://images.unsplash.com/photo-1584100936595-c0654b55a2e2?auto=format&fit=crop&w=800&q=80",
    badge: "Unique",
  },
  {
    title: "Custom Apparel & Tees",
    subtitle: "100% bio-washed cotton round-neck & oversized custom tees",
    price: "From ₹299",
    href: "/products#clothing",
    image: "https://images.unsplash.com/photo-1521572267360-ee0c2909d518?auto=format&fit=crop&w=800&q=80",
    badge: "Premium",
  },
  {
    title: "MDF Gifts & Keepsakes",
    subtitle: "Laser-cut wooden keychains, desk plaques & custom mouse pads",
    price: "From ₹49",
    href: "/products#mdf-gifts",
    image: "https://images.unsplash.com/photo-1513519245088-0e12902e5a38?auto=format&fit=crop&w=800&q=80",
    badge: "Affordable",
  },
]

// Trust and value proposition badges
const valueHighlights = [
  {
    icon: Clock,
    title: "24–48h Fast Dispatch",
    desc: "Speedy production & prompt shipping across India",
  },
  {
    icon: Package,
    title: "No Minimum Orders",
    desc: "Order 1 personalized piece or 5,000+ units",
  },
  {
    icon: Sparkles,
    title: "High-Definition Prints",
    desc: "Vibrant, durable sublimation & direct print clarity",
  },
  {
    icon: Layers,
    title: "Bulk Tier Savings",
    desc: "Save up to 45% for corporate, college & event orders",
  },
]

// 3-step simple process
const howItWorks = [
  {
    step: "01",
    icon: Palette,
    title: "Choose Your Canvas",
    desc: "Select from mugs, apparel, rock frames, water bottles, or corporate kits in our catalog.",
  },
  {
    step: "02",
    icon: Sparkles,
    title: "Share Your Design",
    desc: "Upload your photos, company logo, artwork, or custom text during checkout or via WhatsApp.",
  },
  {
    step: "03",
    icon: Truck,
    title: "Handcrafted & Delivered",
    desc: "We print with vivid, durable precision and carefully deliver right to your doorstep.",
  },
]

// Curated best seller products
const defaultFeaturedItems = [
  { slug: "white-mug-a001", categorySlug: "ceramic-mug" },
  { slug: "motto-ceramic-mug-a111", categorySlug: "ceramic-mug" },
  { slug: "bb30-double-wall-with-steel-cap-a130", categorySlug: "stainless-steel-drinkware" },
  { slug: "sweet-heart-collage-frame-a053", categorySlug: "mdf-collage-frame" },
  { slug: "magic-square-with-white-back-a075", categorySlug: "flip-sequin-pillow-cover" },
  { slug: "black-t-shirt-a085", categorySlug: "t-shirt" },
  { slug: "semicircle-stone-frame-sh-01", categorySlug: "stone-frame" },
  { slug: "blended-plush-tote-bag-a090", categorySlug: "tote-bag" },
]

let featuredProducts: { product: any; categorySlug: string }[] = []

try {
  const result = await getVendureGroupedSections()
  if (result && result.groupedSections && result.groupedSections.length > 0) {
    const allVendure = result.groupedSections.flatMap((s: any) =>
      s.products.map((p: any) => ({
        product: p,
        categorySlug: s.id,
      }))
    )
    if (allVendure.length > 0) {
      featuredProducts = allVendure.slice(0, 8)
    }
  }
} catch {
  // Fall back to catalogue mock
}

if (featuredProducts.length === 0) {
  featuredProducts = defaultFeaturedItems
    .map((item) => {
      const prod = getProductBySlug(item.slug)
      return prod ? { product: prod, categorySlug: item.categorySlug } : null
    })
    .filter((x): x is { product: any; categorySlug: string } => Boolean(x))
}
---

<Layout
  title="RS Prints - Custom Printing Studio & Personalized Merchandise"
  description="Order custom printed mugs, apparel, personalized photo gifts, drinkware, and corporate merchandise with vibrant HD print quality and fast dispatch across India."
  canonicalUrl="/"
  currentActive="home"
>
  <div class="space-y-16 sm:space-y-20 pb-16">
    <!-- 1. Hero Section -->
    <section class="container mx-auto px-4 pt-6 sm:pt-10">
      <div class="flex flex-col items-center text-center max-w-3xl mx-auto space-y-5">
        <!-- Eyebrow Pill -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-semibold bg-primary/20 text-foreground border border-primary/40 shadow-2xs">
          <Sparkles class="size-3.5 text-primary" />
          <span>Custom Print Studio & Merchandise</span>
        </div>

        <!-- Headline -->
        <h1 class="font-heading text-3xl sm:text-5xl md:text-6xl font-bold tracking-tight text-foreground leading-[1.12]">
          Turn Your Ideas & Memories Into{" "}
          <span class="bg-gradient-to-r from-amber-500 via-yellow-500 to-orange-500 bg-clip-text text-transparent">
            Custom Prints
          </span>
        </h1>

        <!-- Subheading -->
        <p class="text-sm sm:text-base text-muted-foreground leading-relaxed max-w-2xl">
          High-definition personalized mugs, apparel, custom drinkware, photo rocks, and corporate merchandise. Handcrafted with care, vivid precision, and fast dispatch across India.
        </p>

        <!-- CTA Action Buttons -->
        <div class="flex flex-wrap items-center justify-center gap-3 pt-2">
          <a
            href="/products"
            class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-2xl bg-primary text-primary-foreground font-semibold text-sm shadow-sm hover:brightness-105 active:scale-[0.98] transition-all"
          >
            Explore Catalogue
            <ArrowRight class="size-4" />
          </a>
          <a
            href="/bulk-order"
            class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-2xl border border-border bg-card hover:bg-muted/70 text-foreground font-semibold text-sm transition-all active:scale-[0.98]"
          >
            <Layers class="size-4 text-muted-foreground" />
            Bulk Orders (Up to 45% Off)
          </a>
          <a
            href={brandConfig.contact.whatsapp.url}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 px-4 py-3 rounded-2xl border border-emerald-500/30 bg-emerald-500/10 hover:bg-emerald-500/20 text-emerald-800 dark:text-emerald-300 font-medium text-sm transition-all"
            aria-label="Direct WhatsApp Enquiry"
          >
            <MessageCircle class="size-4 text-emerald-600" />
            <span class="hidden sm:inline">WhatsApp Enquiry</span>
          </a>
        </div>
      </div>

      <!-- Hero Visual Banner Card -->
      <div class="mt-8 sm:mt-12">
        <a
          href="/products"
          class="group relative block overflow-hidden rounded-2xl sm:rounded-3xl border border-border/80 shadow-xs transition-all duration-300 hover:shadow-md hover:border-primary/50"
          aria-label="Shop all custom printed products"
        >
          <img
            src="/shop-all-banner2.png"
            alt="RS Prints Bulk Custom Printing & Corporate Solutions"
            class="h-auto w-full object-cover select-none transition-transform duration-700 ease-out group-hover:scale-[1.01]"
            draggable="false"
            width="2170"
            height="409"
            loading="eager"
            decoding="async"
          />
        </a>
      </div>
    </section>

    <!-- 2. Value Highlights / Trust Badges -->
    <section class="container mx-auto px-4">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3 sm:gap-4">
        {valueHighlights.map((item) => (
          <div class="flex items-start gap-3 p-4 sm:p-5 rounded-2xl border border-border/70 bg-card/70 backdrop-blur-xs transition-colors hover:border-border">
            <div class="p-2.5 rounded-xl bg-primary/15 text-primary shrink-0 mt-0.5">
              <item.icon class="size-4 sm:size-5" />
            </div>
            <div class="space-y-0.5 min-w-0">
              <h3 class="text-xs sm:text-sm font-semibold text-foreground leading-tight">
                {item.title}
              </h3>
              <p class="text-[11px] sm:text-xs text-muted-foreground leading-snug">
                {item.desc}
              </p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- 3. Popular Categories Grid -->
    <section class="container mx-auto px-4 space-y-6">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3 border-b border-border/40 pb-4">
        <div class="space-y-1">
          <span class="text-[11px] font-mono uppercase tracking-wider text-primary font-bold">
            Browse Catalogue
          </span>
          <h2 class="text-xl sm:text-2xl md:text-3xl font-heading font-bold text-foreground tracking-tight">
            Popular Categories
          </h2>
          <p class="text-xs sm:text-sm text-muted-foreground">
            Explore customer-favorite categories handcrafted with premium finishes.
          </p>
        </div>
        <a
          href="/products"
          class="inline-flex items-center gap-1 text-xs sm:text-sm font-semibold text-primary hover:underline group"
        >
          View all categories
          <ChevronRight class="size-3.5 group-hover:translate-x-0.5 transition-transform" />
        </a>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-3 gap-3.5 sm:gap-5">
        {popularCategories.map((cat) => (
          <a
            href={cat.href}
            class="group relative flex flex-col overflow-hidden rounded-2xl border border-border/70 bg-card transition-all duration-300 hover:-translate-y-1 hover:border-primary/60 hover:shadow-md"
          >
            <!-- Category Image -->
            <div class="relative aspect-4/3 w-full overflow-hidden bg-muted/40">
              <img
                src={cat.image}
                alt={cat.title}
                class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-106"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/10 to-transparent opacity-80 group-hover:opacity-70 transition-opacity" />

              <!-- Category Badge -->
              <div class="absolute top-2.5 left-2.5">
                <span class="rounded-md bg-card/90 backdrop-blur-md px-2 py-0.5 text-[10px] font-semibold text-foreground border border-border/60 shadow-2xs">
                  {cat.badge}
                </span>
              </div>

              <!-- Price Tag -->
              <div class="absolute bottom-2.5 right-2.5">
                <span class="rounded-md bg-background/90 backdrop-blur-md px-2 py-0.5 text-[11px] font-mono font-semibold text-foreground border border-border/60 shadow-2xs">
                  {cat.price}
                </span>
              </div>
            </div>

            <!-- Content -->
            <div class="p-3.5 sm:p-4 space-y-1">
              <div class="flex items-center justify-between">
                <h3 class="font-heading text-sm sm:text-base font-semibold text-foreground group-hover:text-primary transition-colors">
                  {cat.title}
                </h3>
                <ArrowUpRight class="size-3.5 text-muted-foreground group-hover:text-primary group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all shrink-0" />
              </div>
              <p class="text-[11px] sm:text-xs text-muted-foreground line-clamp-1">
                {cat.subtitle}
              </p>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- 4. Customer Favorites / Featured Best Sellers -->
    <section class="container mx-auto px-4 space-y-6">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3 border-b border-border/40 pb-4">
        <div class="space-y-1">
          <span class="text-[11px] font-mono uppercase tracking-wider text-primary font-bold">
            Curated Picks
          </span>
          <h2 class="text-xl sm:text-2xl md:text-3xl font-heading font-bold text-foreground tracking-tight">
            Customer Favorites
          </h2>
          <p class="text-xs sm:text-sm text-muted-foreground">
            Top-rated personalized products ready for your photos and custom text.
          </p>
        </div>
        <a
          href="/products"
          class="inline-flex items-center gap-1 text-xs sm:text-sm font-semibold text-primary hover:underline group"
        >
          Shop all 240+ products
          <ChevronRight class="size-3.5 group-hover:translate-x-0.5 transition-transform" />
        </a>
      </div>

      <!-- Minimal Product Cards Grid -->
      <div class="grid grid-cols-2 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3.5 sm:gap-4.5">
        {featuredProducts.map((item) => (
          <MinimalProductCard
            product={item.product}
            categorySlug={item.categorySlug}
          />
        ))}
      </div>

      <div class="pt-4 text-center">
        <a
          href="/products"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-2xl border border-border bg-card hover:bg-muted/70 text-foreground text-sm font-semibold transition-all hover:scale-[1.01] active:scale-[0.99] shadow-2xs"
        >
          View Full Catalogue
          <ArrowRight class="size-4" />
        </a>
      </div>
    </section>

    <!-- 5. How Custom Printing Works (3 Simple Steps) -->
    <section class="container mx-auto px-4">
      <div class="rounded-3xl border border-border/80 bg-card/60 p-6 sm:p-10 space-y-8">
        <div class="text-center max-w-xl mx-auto space-y-2">
          <span class="text-[11px] font-mono uppercase tracking-wider text-primary font-bold">
            Easy Process
          </span>
          <h2 class="text-xl sm:text-3xl font-heading font-bold text-foreground tracking-tight">
            How Custom Printing Works
          </h2>
          <p class="text-xs sm:text-sm text-muted-foreground">
            Turn your idea into a physical handcrafted keepsake in 3 straightforward steps.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 relative">
          {howItWorks.map((step) => (
            <div class="relative flex flex-col items-center text-center p-5 rounded-2xl border border-border/50 bg-background/50 space-y-3">
              <div class="flex items-center justify-center size-12 rounded-2xl bg-primary/15 text-primary">
                <step.icon class="size-6" />
              </div>
              <span class="text-xs font-mono font-bold text-muted-foreground uppercase">
                Step {step.step}
              </span>
              <h3 class="text-base font-heading font-semibold text-foreground">
                {step.title}
              </h3>
              <p class="text-xs text-muted-foreground leading-relaxed">
                {step.desc}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 6. Bulk & Corporate Orders Highlight Banner Card -->
    <section class="container mx-auto px-4">
      <div class="relative rounded-3xl border border-primary/30 bg-gradient-to-br from-card via-card to-primary/5 p-6 sm:p-10 md:p-12 shadow-xs overflow-hidden flex flex-col md:flex-row items-center justify-between gap-8">
        <!-- Subtle Glow Backdrop -->
        <div class="absolute -right-20 -bottom-20 size-80 rounded-full bg-primary/15 blur-3xl pointer-events-none" />

        <div class="space-y-4 max-w-xl z-10">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-primary/20 text-foreground border border-primary/40">
            <Layers class="size-3.5 text-primary" />
            Corporate & Bulk Solutions
          </div>
          <h2 class="text-2xl sm:text-3xl md:text-4xl font-heading font-bold text-foreground tracking-tight leading-tight">
            Planning a Bulk Order or Corporate Gifting?
          </h2>
          <p class="text-xs sm:text-sm text-muted-foreground leading-relaxed">
            Get customized staff merchandise, college fest tees, wedding souvenirs, and promotional kits with free digital proofs and tiered volume discounts up to 45%.
          </p>

          <div class="flex flex-wrap gap-x-5 gap-y-2 pt-1 text-xs text-foreground font-medium">
            <span class="inline-flex items-center gap-1.5">
              <CheckCircle2 class="size-4 text-emerald-500" />
              Free digital mockup proof
            </span>
            <span class="inline-flex items-center gap-1.5">
              <CheckCircle2 class="size-4 text-emerald-500" />
              GST invoice & bulk packaging
            </span>
            <span class="inline-flex items-center gap-1.5">
              <CheckCircle2 class="size-4 text-emerald-500" />
              Pan-India direct delivery
            </span>
          </div>
        </div>

        <div class="flex flex-col sm:flex-row md:flex-col lg:flex-row items-stretch sm:items-center gap-3 w-full md:w-auto z-10 shrink-0">
          <a
            href="/bulk-order"
            class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-2xl bg-primary text-primary-foreground font-semibold text-sm shadow-sm hover:brightness-105 active:scale-[0.98] transition-all text-center"
          >
            Get Bulk Quote
            <ArrowRight class="size-4" />
          </a>
          <a
            href={brandConfig.contact.whatsapp.url}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 px-5 py-3.5 rounded-2xl border border-border bg-background hover:bg-muted text-foreground text-sm font-medium transition-all text-center"
          >
            <MessageCircle class="size-4 text-emerald-600" />
            Talk on WhatsApp
          </a>
        </div>
      </div>
    </section>
  </div>
</Layout>
