---
import Layout from "@/layouts/main.astro";
import brandConfig from "@/data/brandConfig.json";
import { setEdgeCache, CACHE_PRESETS } from "@/lib/cache";

// CLOUDFLARE EDGE CACHING: Shipping & refund policies cached at edge for 1 hour
setEdgeCache(Astro.response, CACHE_PRESETS.MARKETING);

const { brand, contact } = brandConfig;
---

<Layout 
  title={`Shipping & Refund Policy - ${brand.name}`}
  description={`Official Shipping and Refund Policy for ${brand.name} (${brand.legalName}). Production timelines, pan-India delivery estimates, return eligibility, reprint guarantees, and refund processing for custom apparel and merchandise.`}
  canonicalUrl="/shipping-and-refund-policy"
  currentActive="shipping"
>
  <main class="container mx-auto px-4 py-8 md:py-12 max-w-4xl flex-1 flex flex-col gap-8">
    <!-- Header Section -->
    <div class="border-b border-border pb-6">
      <h1 class="text-2xl md:text-4xl font-heading font-bold tracking-tight text-foreground">
        Shipping & Refund Policy
      </h1>
      <p class="text-sm md:text-base text-muted-foreground mt-2 leading-relaxed text-justify">
        Clear guidelines regarding manufacturing lead times, pan-India shipping, delivery estimates, return conditions, and replacement policies for custom merchandise manufactured by {brand.name} ({brand.legalName}).
      </p>
    </div>

    <!-- Policy Content Sections -->
    <div class="text-xs md:text-sm leading-relaxed text-muted-foreground space-y-8 font-sans text-justify">
      
      <!-- Section 1: Custom Production & Dispatch Timelines -->
      <section class="space-y-3">
        <h2 class="text-base md:text-lg font-heading font-semibold text-foreground tracking-wide flex items-center gap-2">
          <span>1.</span> Custom Production Lead Times & Processing
        </h2>
        <p>
          Because every item ordered from <strong class="text-foreground">{brand.name}</strong> is custom-manufactured, customized apparel and bespoke photo gifts undergo graphic pre-flight checks, physical printing, curing, and rigorous quality inspection prior to packaging:
        </p>
        <ul class="list-disc pl-5 space-y-1.5">
          <li>
            <strong class="text-foreground">Standard Custom Production:</strong> Requires <span class="font-semibold text-foreground">2 to 4 business days</span> from the time payment is verified and print-ready artwork is approved.
          </li>
          <li>
            <strong class="text-foreground">Bulk & Corporate Orders:</strong> Production timelines for large volume orders (50+ units) depend on batch quantity and will be confirmed upfront by our corporate printing desk.
          </li>
          <li>
            <strong class="text-foreground">Dispatch Notification:</strong> Once your order clears inspection and is handed over to our logistics partner, automated confirmation notifications with live tracking links are dispatched to your registered email and phone number.
          </li>
        </ul>
      </section>

      <!-- Section 2: Shipping Estimates & Logistics Partners -->
      <section class="space-y-3">
        <h2 class="text-base md:text-lg font-heading font-semibold text-foreground tracking-wide flex items-center gap-2">
          <span>2.</span> Shipping Estimates & Pan-India Coverage
        </h2>
        <p>
          We deliver across serviceable PIN codes in India in collaboration with recognized domestic logistics carriers (e.g., Delhivery, BlueDart, Shiprocket, DTDC, India Post). Transit times begin after order dispatch:
        </p>
        <div class="overflow-x-auto rounded-xl border border-border mt-2">
          <table class="w-full text-left text-xs md:text-sm">
            <thead class="bg-muted/60 text-foreground font-semibold border-b border-border">
              <tr>
                <th class="p-3">Delivery Zone</th>
                <th class="p-3">Estimated Transit Window</th>
                <th class="p-3">Service Type</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-border">
              <tr>
                <td class="p-3 font-medium text-foreground">Tier-1 Metro Cities (Delhi NCR, Mumbai, Bengaluru, Chennai, Kolkata, Hyderabad)</td>
                <td class="p-3">2 – 4 Business Days</td>
                <td class="p-3">Express Air / Surface</td>
              </tr>
              <tr>
                <td class="p-3 font-medium text-foreground">Tier-2 & Tier-3 Regional Cities</td>
                <td class="p-3">4 – 7 Business Days</td>
                <td class="p-3">Standard Surface / Air</td>
              </tr>
              <tr>
                <td class="p-3 font-medium text-foreground">North-East, Jammu & Kashmir, Rural & Remote Territories</td>
                <td class="p-3">7 – 10 Business Days</td>
                <td class="p-3">National Network / Speed Post</td>
              </tr>
            </tbody>
          </table>
        </div>
        <p class="text-xs text-muted-foreground italic mt-1">
          *Note: Delivery timelines are estimates and exclude Sundays and national public holidays. Delivery speeds may be impacted by extreme weather, regional transport restrictions, or festive courier surges.
        </p>
      </section>

      <!-- Section 3: Shipping Charges & Order Tracking -->
      <section class="space-y-3">
        <h2 class="text-base md:text-lg font-heading font-semibold text-foreground tracking-wide flex items-center gap-2">
          <span>3.</span> Shipping Charges & Live Consignment Tracking
        </h2>
        <p>
          Shipping charges are calculated transparently during checkout based on volumetric package weight, destination PIN code, and courier rate cards:
        </p>
        <ul class="list-disc pl-5 space-y-1.5">
          <li>
            <strong class="text-foreground">Free Shipping Promotions:</strong> Free standard shipping may apply on qualified orders meeting cart thresholds as advertised on our store.
          </li>
          <li>
            <strong class="text-foreground">Live Tracking:</strong> As soon as the consignment is scanned by the courier, you will receive a tracking link via email and WhatsApp allowing real-time tracking from our Delhi studio to your doorstep.
          </li>
        </ul>
      </section>

      <!-- Section 4: Cash on Delivery (COD) Rules -->
      <section class="space-y-3">
        <h2 class="text-base md:text-lg font-heading font-semibold text-foreground tracking-wide flex items-center gap-2">
          <span>4.</span> Cash on Delivery (COD) Terms
        </h2>
        <p>
          Where Cash on Delivery is enabled for eligible PIN codes and product categories:
        </p>
        <ul class="list-disc pl-5 space-y-1.5">
          <li>Orders placed under COD may be verified via telephone or automated OTP before production is queued.</li>
          <li>Payment must be tendered in full (via cash or courier-supported UPI QR terminal) prior to receiving the package. Couriers do not permit opening parcels prior to payment.</li>
          <li>Unwarranted rejection of custom-printed COD shipments upon delivery may lead to permanent deactivation of COD privileges on your account.</li>
        </ul>
      </section>

      <!-- Section 5: Delivery Attempts & Undeliverable Shipments -->
      <section class="space-y-3">
        <h2 class="text-base md:text-lg font-heading font-semibold text-foreground tracking-wide flex items-center gap-2">
          <span>5.</span> Delivery Attempts & Return to Origin (RTO)
        </h2>
        <p>
          Our courier partners make up to <strong class="text-foreground">three (3) delivery attempts</strong> at the shipping address supplied during checkout:
        </p>
        <ul class="list-disc pl-5 space-y-1.5">
          <li>Ensure your address contains complete details (house/flat number, building, street, landmark, and valid 6-digit PIN code) along with an active mobile contact number.</li>
          <li>If delivery fails following three attempts due to customer unavailability, incorrect contact details, or refusal, the consignment is returned to our facility as <strong>Return to Origin (RTO)</strong>.</li>
          <li>
            <strong class="text-foreground">Important:</strong> Because personalized custom apparel and customized merchandise are printed uniquely for you and cannot be restocked or sold to another buyer, RTO orders cannot be refunded. Consignments will be held for fourteen (14) days and can be re-shipped upon settlement of secondary courier charges.
          </li>
        </ul>
      </section>

      <!-- Section 6: Cancellation Policy -->
      <section class="space-y-3">
        <h2 class="text-base md:text-lg font-heading font-semibold text-foreground tracking-wide flex items-center gap-2">
          <span>6.</span> Cancellation Window for Custom Orders
        </h2>
        <p>
          Because our custom printing workflow starts promptly upon receiving your order:
        </p>
        <ul class="list-disc pl-5 space-y-1.5">
          <li>
            <strong class="text-foreground">Grace Cancellation Window:</strong> You may request an order cancellation within <strong class="text-foreground">two (2) hours</strong> of placement by sending an urgent request to <a href={`mailto:${contact.email.support}`} class="text-primary hover:underline font-mono">{contact.email.support}</a> or messaging our WhatsApp hotline with your Order ID.
          </li>
          <li>
            <strong class="text-foreground">Post-Production Ineligibility:</strong> Once raw materials are allocated, screen/digital plates prepared, or printing has commenced, custom orders cannot be cancelled, modified, or refunded.
          </li>
        </ul>
      </section>

      <!-- Section 7: Defective Items & 7-Day Quality Claim Window -->
      <section class="space-y-3">
        <h2 class="text-base md:text-lg font-heading font-semibold text-foreground tracking-wide flex items-center gap-2">
          <span>7.</span> Quality Guarantee & Defect Claims Procedure
        </h2>
        <p>
          {brand.name} stands behind the quality of its craftsmanship. If your delivered items suffer from an authentic manufacturing defect, physical transit damage, or incorrect product dispatch:
        </p>
        <ul class="list-disc pl-5 space-y-1.5">
          <li>
            <strong class="text-foreground">Reporting Window:</strong> You must report the issue within <strong class="text-foreground">seven (7) calendar days</strong> of parcel delivery.
          </li>
          <li>
            <strong class="text-foreground">Required Evidence:</strong> Send an email to <a href={`mailto:${contact.email.support}`} class="text-primary hover:underline font-mono">{contact.email.support}</a> containing your Order ID, a clear photo of the shipping label on the package, and clear photographs or an unboxing video highlighting the specific defect or damage.
          </li>
          <li>
            <strong class="text-foreground">Expedited Resolution:</strong> Upon verification by our quality control team, we will manufacture and dispatch an immediate <strong>free reprint and replacement</strong> at no additional cost to you. If a replacement cannot be fulfilled, a full refund will be processed.
          </li>
        </ul>
      </section>

      <!-- Section 8: Non-Returnable Scenarios (Customer Proofing) -->
      <section class="space-y-3">
        <h2 class="text-base md:text-lg font-heading font-semibold text-foreground tracking-wide flex items-center gap-2">
          <span>8.</span> Non-Returnable Scenarios (Customer Responsibility)
        </h2>
        <p>
          Because customized merchandise cannot be re-sold, we cannot accept returns, replacements, or issue refunds for issues stemming from customer input:
        </p>
        <ul class="list-disc pl-5 space-y-1.5">
          <li>Spelling, grammatical, typographical, or naming errors in text supplied by the customer;</li>
          <li>Pixelation or blurriness resulting from low-resolution images or compressed graphics uploaded by the customer;</li>
          <li>Customer ordering an incorrect garment size (accurate measurements and size charts are provided on every product page);</li>
          <li>Standard industry color variance (5% to 10%) between on-screen RGB digital displays and physical CMYK garment/paper prints;</li>
          <li>Change of mind, buyer’s remorse, or personal preference after custom production has taken place.</li>
        </ul>
      </section>

      <!-- Section 9: Return Pickup Procedure -->
      <section class="space-y-3">
        <h2 class="text-base md:text-lg font-heading font-semibold text-foreground tracking-wide flex items-center gap-2">
          <span>9.</span> Return Pickup & Inspection
        </h2>
        <p>
          Where our customer support team authorizes a physical return for evaluation:
        </p>
        <ul class="list-disc pl-5 space-y-1.5">
          <li>We will schedule a reverse pickup via our logistics partner at your registered address (up to 3 pickup attempts);</li>
          <li>The item must be packed securely in original packaging along with all accompanying tags and invoices;</li>
          <li>Upon receipt at our New Delhi facility, our quality team inspects the article within <strong>forty-eight (48) hours</strong> to release the replacement or approve the refund.</li>
        </ul>
      </section>

      <!-- Section 10: Refund Settlement & Timelines -->
      <section class="space-y-3">
        <h2 class="text-base md:text-lg font-heading font-semibold text-foreground tracking-wide flex items-center gap-2">
          <span>10.</span> Refund Processing Timelines
        </h2>
        <p>
          Once a refund is approved by our operations desk:
        </p>
        <ul class="list-disc pl-5 space-y-1.5">
          <li>
            <strong class="text-foreground">Prepaid Transactions (UPI, Credit/Debit Cards, Net Banking):</strong> The refund is credited back to the original source account within <strong class="text-foreground">7 to 10 business days</strong>, subject to your bank’s clearing cycle.
          </li>
          <li>
            <strong class="text-foreground">Cash on Delivery Orders:</strong> Refunds are remitted directly to the customer’s verified bank account via NEFT / IMPS within 7 business days following receipt of bank account details.
          </li>
          <li>
            <strong class="text-foreground">Store Credit Option:</strong> Customers may opt for instant Store Credit coupon codes, valid for forty-five (45) days for any future purchase.
          </li>
          <li>
            <strong class="text-foreground">Bank Reference (UTR):</strong> A Unique Transaction Reference (UTR) or Acquirer Reference Number (ARN) will be provided for tracking upon completion of the refund transfer.
          </li>
        </ul>
      </section>

      <!-- Section 11: Support & Customer Inquiries -->
      <section class="space-y-3">
        <h2 class="text-base md:text-lg font-heading font-semibold text-foreground tracking-wide flex items-center gap-2">
          <span>11.</span> Customer Support & Helpdesk
        </h2>
        <p>
          For any questions concerning shipment status, artwork proofs, transit queries, or defect claims, please reach our customer support team:
        </p>
        <div class="p-5 md:p-6 rounded-2xl border border-border bg-card/80 space-y-3 text-xs md:text-sm">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-left">
            <div>
              <span class="text-muted-foreground block text-xs uppercase tracking-wider font-semibold">Entity</span>
              <span class="font-medium text-foreground">{brand.legalName} ({brand.name})</span>
            </div>
            <div>
              <span class="text-muted-foreground block text-xs uppercase tracking-wider font-semibold">Support Email</span>
              <a href={`mailto:${contact.email.support}`} class="text-primary hover:underline font-mono font-medium">
                {contact.email.support}
              </a>
            </div>
            <div>
              <span class="text-muted-foreground block text-xs uppercase tracking-wider font-semibold">Hotline & WhatsApp</span>
              <a href={`tel:${contact.phone.raw}`} class="text-foreground hover:text-primary font-mono font-medium block">
                {contact.phone.display}
              </a>
            </div>
            <div>
              <span class="text-muted-foreground block text-xs uppercase tracking-wider font-semibold">Working Hours</span>
              <span class="font-medium text-foreground">{contact.hours.display}</span>
            </div>
            <div class="sm:col-span-2">
              <span class="text-muted-foreground block text-xs uppercase tracking-wider font-semibold">Facility & Returns Address</span>
              <span class="font-medium text-foreground">
                {contact.address.line1}, {contact.address.line2}, {contact.address.city}, {contact.address.state} - {contact.address.postalCode}, India
              </span>
            </div>
          </div>
        </div>
      </section>

    </div>
  </main>
</Layout>
