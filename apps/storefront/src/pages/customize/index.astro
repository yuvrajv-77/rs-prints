---
/**
 * Main Product Customizer Studio (`/customize`)
 *
 * Dedicated landing studio allowing customers to choose between T-shirts, Mugs,
 * and custom drinkware, upload their artwork, and preview mockups live.
 */
import Layout from "@/layouts/main.astro"
import ProductCustomizer from "@/components/customizer/ProductCustomizer"
import { setEdgeCache, CACHE_PRESETS } from "@/lib/cache"
import {
  Breadcrumb,
  BreadcrumbList,
  BreadcrumbItem,
  BreadcrumbLink,
  BreadcrumbSeparator,
  BreadcrumbPage
} from "@/components/ui/breadcrumb"

// Cache edge response
setEdgeCache(Astro.response, CACHE_PRESETS.STATIC_PAGE)
---

<Layout
  title="Interactive Product Customizer Studio - RS Prints"
  description="Customize your t-shirts, mugs, and corporate gifts online. Upload high-res artwork, adjust placement on photorealistic mockups, and order directly."
  canonicalUrl="/customize"
  hideFooter={true}
  noScroll={true}
>
  <div class="w-full h-full min-h-0 flex flex-col overflow-hidden">
    <ProductCustomizer client:load />
  </div>
</Layout>
