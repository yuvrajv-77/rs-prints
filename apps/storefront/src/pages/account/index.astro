---
// Redirect /account directly to /account/profile or tab from query param
const targetSection = Astro.url.searchParams.get("tab") || 
                      Astro.url.searchParams.get("section") || 
                      "profile"

return Astro.redirect(`/account/${targetSection}`)
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0;url=/account/${targetSection}`} />
    <title>Redirecting to Account...</title>
  </head>
  <body>
    <script is:inline define:vars={{ targetSection }}>
      window.location.replace(`/account/${targetSection}`)
    </script>
  </body>
</html>
