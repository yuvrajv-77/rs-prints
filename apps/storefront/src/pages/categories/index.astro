---
import Layout from "@/layouts/main.astro"
import { getAllCategories } from "@/lib/catalog"
import { setEdgeCache, CACHE_PRESETS } from "@/lib/cache"
import CategoryDirectoryCard from "@/components/category/CategoryDirectoryCard.astro"

// ============================================================================
// CLOUDFLARE EDGE CACHING
// - s-maxage=300 (5 min): Caches complete categories directory at edge.
// ============================================================================
setEdgeCache(Astro.response, CACHE_PRESETS.CATALOG)
import {
  Breadcrumb,
  BreadcrumbList,
  BreadcrumbItem,
  BreadcrumbLink,
  BreadcrumbSeparator,
  BreadcrumbPage,
} from "@/components/ui/breadcrumb"
import { Grid, Sparkles, Zap, PhoneCall } from "lucide-react"
import brandConfig from "@/data/brandConfig.json"

const categories = await getAllCategories()
const totalProducts = categories.reduce((sum, c) => sum + c.totalCount, 0)
const totalSubcategories = categories.reduce((sum, c) => sum + c.subcategories.length, 0)
---

<Layout
  title="All Categories & Custom Merchandise Collections - RS Prints"
  description="Browse our complete directory of custom printing categories: personalized apparel, custom mugs, drinkware, rock photo frames, cushions, and promotional corporate merchandise."
  canonicalUrl="/categories"
  currentActive="categories"
>
  <!-- Top Hero & Breadcrumbs -->
  <section class="border-b border-border/60 bg-linear-to-b from-primary/10 via-background to-background pt-6 pb-10 md:pt-10 md:pb-14">
    <div class="container mx-auto px-4">
      <div class="mb-5">
        <Breadcrumb>
          <BreadcrumbList className="text-xs sm:text-sm">
            <BreadcrumbItem>
              <BreadcrumbLink href="/">Home</BreadcrumbLink>
            </BreadcrumbItem>
            <BreadcrumbSeparator />
            <BreadcrumbItem>
              <BreadcrumbPage className="font-semibold text-foreground">Categories</BreadcrumbPage>
            </BreadcrumbItem>
          </BreadcrumbList>
        </Breadcrumb>
      </div>

      <div class="max-w-3xl space-y-3">
        <div class="inline-flex items-center gap-1.5 rounded-full bg-primary/15 px-3 py-1 text-xs font-semibold text-primary border border-primary/30">
          <Sparkles className="size-3.5" />
          <span>Complete Catalog Index</span>
        </div>
        <h1 class="font-heading text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-extrabold tracking-tight text-foreground">
          Explore All Categories
        </h1>
        <p class="text-xs sm:text-sm md:text-base text-muted-foreground leading-relaxed">
          Discover our full spectrum of custom printing services. Choose a department below to explore curated collections, custom specs, and volume-discounted merchandise.
        </p>

        <!-- Summary Statistics Chips -->
        <div class="flex items-center gap-2 pt-2 flex-wrap">
          <span class="inline-flex items-center gap-1.5 rounded-lg bg-card border border-border/70 px-3 py-1.5 text-xs font-mono text-foreground">
            <Grid className="size-3.5 text-primary" />
            <strong class="font-semibold">{categories.length}</strong> Departments
          </span>
          <span class="inline-flex items-center gap-1.5 rounded-lg bg-card border border-border/70 px-3 py-1.5 text-xs font-mono text-foreground">
            <strong class="font-semibold">{totalSubcategories}</strong> Specialized Collections
          </span>
          <span class="inline-flex items-center gap-1.5 rounded-lg bg-card border border-border/70 px-3 py-1.5 text-xs font-mono text-foreground">
            <strong class="font-semibold">{totalProducts}</strong> Total Products
          </span>
        </div>
      </div>
    </div>
  </section>

  <!-- Sticky Quick Jump Department Bar -->
  <div class="sticky top-16 z-20 bg-background/95 backdrop-blur-md border-b border-border/60 py-3 shadow-2xs">
    <div class="container mx-auto px-4">
      <div class="flex items-center gap-2 overflow-x-auto scrollbar-none snap-x py-0.5">
        <span class="text-xs font-semibold text-muted-foreground shrink-0 uppercase tracking-wider pr-1">
          Quick Jump:
        </span>
        {categories.map((cat) => (
          <a
            href={`#dept-${cat.id}`}
            class="snap-start shrink-0 px-3 py-1 rounded-full text-xs font-medium bg-muted/70 hover:bg-primary/15 hover:text-primary transition-colors border border-border/50 text-foreground/80 whitespace-nowrap"
          >
            {cat.title} ({cat.totalCount})
          </a>
        ))}
      </div>
    </div>
  </div>

  <!-- Main Directory Grid -->
  <section class="container mx-auto px-4 py-10 md:py-14 space-y-10">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
      {categories.map((cat) => (
        <div id={`dept-${cat.id}`} class="scroll-mt-32">
          <CategoryDirectoryCard category={cat} />
        </div>
      ))}
    </div>

    <!-- Bulk & Corporate Banner -->
    <div class="rounded-3xl border border-primary/25 bg-gradient-to-br from-primary/15 via-card to-background p-6 shadow-sm sm:p-8 md:p-10 mt-12">
      <div class="max-w-2xl space-y-3">
        <div class="inline-flex items-center gap-2 rounded-full border border-primary/40 bg-primary/20 px-3 py-0.5 text-xs font-semibold text-foreground">
          <Zap className="size-3.5" />
          <span>Wholesale & Event Solutions</span>
        </div>
        <h2 class="font-heading text-xl font-bold tracking-tight text-foreground sm:text-2xl md:text-3xl">
          Need a Custom Multi-Category Package?
        </h2>
        <p class="text-xs leading-relaxed text-muted-foreground sm:text-sm md:text-base">
          Combine custom t-shirts, engraved mugs, photo frames, and welcome kits in a single bulk order. We offer corporate discount tiers, sample approvals, and custom branded packaging.
        </p>
        <div class="flex flex-wrap items-center gap-3 pt-3">
          <a
            href="/bulk-order"
            class="inline-flex items-center justify-center rounded-xl bg-primary px-5 py-2.5 text-xs font-semibold text-primary-foreground shadow-xs transition-colors hover:bg-primary/90 sm:text-sm"
          >
            Request Bulk Quote
          </a>
          <a
            href={brandConfig.contact.whatsapp.url}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-1.5 rounded-xl border border-border bg-card px-5 py-2.5 text-xs font-semibold text-foreground transition-colors hover:bg-muted sm:text-sm"
          >
            <PhoneCall className="size-3.5" />
            <span>Chat on WhatsApp</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
