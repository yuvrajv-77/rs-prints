---
import Layout from "@/layouts/main.astro";
import brandConfig from "@/data/brandConfig.json";
import { setEdgeCache, CACHE_PRESETS } from "@/lib/cache";

// CLOUDFLARE EDGE CACHING: Legal terms cached at edge for 1 hour
setEdgeCache(Astro.response, CACHE_PRESETS.MARKETING);

const { brand, contact } = brandConfig;
---

<Layout 
  title={`Terms & Conditions - ${brand.name}`}
  description={`Official Terms and Conditions for ${brand.name} (${brand.legalName}). Read our ordering guidelines, custom printing terms, GST compliance, delivery rules, and dispute resolution under Indian Law.`}
  canonicalUrl="/terms-and-conditions"
  currentActive="terms"
>
  <main class="container mx-auto px-4 py-8 md:py-12 max-w-4xl flex-1 flex flex-col gap-8">
    <!-- Header Section -->
    <div class="border-b border-border pb-6">
      <h1 class="text-2xl md:text-4xl font-heading font-bold tracking-tight text-foreground">
        Terms & Conditions of Service
      </h1>
      <p class="text-sm md:text-base text-muted-foreground mt-2 leading-relaxed text-justify">
        Please read these General Terms and Conditions carefully before accessing our website, uploading custom artwork, or placing orders with {brand.name} ({brand.legalName}).
      </p>
    </div>

    <!-- Content Sections -->
    <div class="text-xs md:text-sm leading-relaxed text-muted-foreground space-y-8 font-sans text-justify">
      
      <!-- Section 1 -->
      <section class="space-y-3">
        <h2 class="text-base md:text-lg font-heading font-semibold text-foreground tracking-wide flex items-center gap-2">
          <span>1.</span> Acceptance of Terms & Entity Information
        </h2>
        <p>
          Welcome to <a href={brand.siteUrl} class="text-primary hover:underline font-mono">{brand.siteUrl}</a> (the “Platform” or “Site”). 
          These General Terms and Conditions (“Terms”) constitute a legally binding electronic agreement between you (“User”, “Customer”, “you”, or “your”) and 
          <strong class="text-foreground">{brand.legalName}</strong> (operating under the commercial brand name <strong class="text-foreground">{brand.name}</strong>, hereinafter referred to as “we”, “us”, “our”, or “RS Prints”), 
          having its principal facility and registered office situated at {contact.address.line1}, {contact.address.line2}, {contact.address.city}, {contact.address.state} - {contact.address.postalCode}, India.
        </p>
        <p>
          By visiting, browsing, registering an account, uploading digital artwork, or purchasing custom apparel, photo gifts, or merchandise on this Platform, you acknowledge that you have read, understood, and agreed to be bound by these Terms, together with our <a href="/privacy-policy" class="text-primary hover:underline">Privacy Policy</a> and <a href="/shipping-and-refund-policy" class="text-primary hover:underline">Shipping & Refund Policy</a>, which are incorporated herein by reference.
        </p>
        <p>
          We reserve the right to amend, modify, or replace any portion of these Terms at our discretion without prior personal notice. The date of the most recent revision will be reflected on this page. Your continued use of the Site following any modifications constitutes full acceptance of the updated Terms.
        </p>
      </section>

      <!-- Section 2 -->
      <section class="space-y-3">
        <h2 class="text-base md:text-lg font-heading font-semibold text-foreground tracking-wide flex items-center gap-2">
          <span>2.</span> User Eligibility & Capacity to Contract
        </h2>
        <p>
          Use of the Platform is governed by the <strong>Indian Contract Act, 1872</strong>. Only individuals who are legally competent to enter into enforceable contracts may transact on this Platform:
        </p>
        <ul class="list-disc pl-5 space-y-1.5">
          <li>You represent and warrant that you are at least eighteen (18) years of age, of sound mind, and not disqualified by any court of law from contracting;</li>
          <li>If you are under eighteen (18) years of age, you may only access the Platform and purchase merchandise under the direct supervision and active consent of a parent or legal guardian who agrees to be bound by these Terms;</li>
          <li>If you are ordering on behalf of a corporate entity, educational institution, or firm, you warrant that you possess requisite legal authority to bind that entity to these Terms.</li>
        </ul>
      </section>

      <!-- Section 3 -->
      <section class="space-y-3">
        <h2 class="text-base md:text-lg font-heading font-semibold text-foreground tracking-wide flex items-center gap-2">
          <span>3.</span> Custom Artwork, Copyrights & Content Guidelines
        </h2>
        <p>
          Because {brand.name} specializes in personalized print manufacturing, on-demand merchandise, and customized apparel, the following terms govern all customer-uploaded graphics, photos, and assets:
        </p>
        <ul class="list-disc pl-5 space-y-2">
          <li>
            <strong class="text-foreground">Intellectual Property Ownership Warranty:</strong> You represent, warrant, and affirm that you are the sole creator and owner of, or possess all necessary commercial licenses, trademark permissions, and legal rights to reproduce all graphics, typography, corporate logos, and photographs you submit for custom printing.
          </li>
          <li>
            <strong class="text-foreground">Strict Indemnification for Infringement:</strong> You agree to fully indemnify, hold harmless, and defend RS Prints and its partners against any claims, statutory damages, legal fees, or lawsuits arising from third-party copyright, trademark, design patent, or publicity rights infringements resulting from artwork uploaded or commissioned by you.
          </li>
          <li>
            <strong class="text-foreground">Prohibited & Unlawful Content:</strong> We strictly prohibit and refuse to manufacture, print, or distribute any User Content that:
            <ul class="list-circle pl-5 pt-1 space-y-1 text-xs">
              <li>Violates the <em>Emblems and Names (Prevention of Improper Use) Act, 1950</em> or unauthorized national emblems;</li>
              <li>Falsely depicts any individual as an authorized government official or candidate under the <em>Representation of the People Act, 1951</em>;</li>
              <li>Is defamatory, obscene, pornographic, promoting hate speech, inciting communal disharmony, or violating public order under the <em>Information Technology Act, 2000</em>;</li>
              <li>Contains counterfeit currency graphics, fraudulent identification documents, or unlawful trade marks.</li>
            </ul>
          </li>
          <li>
            <strong class="text-foreground">Right of Refusal & Order Rejection:</strong> RS Prints reserves the absolute right, without liability or explanation, to cancel and refund any custom print order containing content that violates our policies or applicable Indian laws.
          </li>
        </ul>
      </section>

      <!-- Section 4 -->
      <section class="space-y-3">
        <h2 class="text-base md:text-lg font-heading font-semibold text-foreground tracking-wide flex items-center gap-2">
          <span>4.</span> Customer Proofing, Print Tolerance & Color Disclaimers
        </h2>
        <p>
          Custom merchandise printing involves physical dyes, direct-to-garment (DTG), sublimation, screen printing, and paper substrates. Please review the following production realities:
        </p>
        <ul class="list-disc pl-5 space-y-1.5">
          <li>
            <strong class="text-foreground">Customer Proofing Responsibility:</strong> RS Prints does not spell-check, proofread, or grammar-check customer-submitted text. You are solely responsible for verifying names, dates, spelling, and placement before confirming your order.
          </li>
          <li>
            <strong class="text-foreground">RGB Screen to CMYK Print Variances:</strong> Digital screens display colors using RGB light spectrums, whereas physical commercial printers output in CMYK ink palettes. A standard industry tolerance of approximately 5% to 10% in color tonal shift, saturation, and fabric absorption is customary and shall not be classified as a manufacturing defect.
          </li>
          <li>
            <strong class="text-foreground">Resolution & File Quality:</strong> We strongly advise providing vector files (AI, PDF, EPS) or high-resolution raster images (minimum 300 DPI). We cannot be held liable for pixelation, blurriness, or low fidelity resulting from low-resolution source files uploaded by the customer.
          </li>
          <li>
            <strong class="text-foreground">Apparel Sizing Tolerances:</strong> Finished garment dimensions may exhibit a standard commercial stitching tolerance of up to &plusmn;0.5 to 1 inch as per industry manufacturing norms.
          </li>
        </ul>
      </section>

      <!-- Section 5 -->
      <section class="space-y-3">
        <h2 class="text-base md:text-lg font-heading font-semibold text-foreground tracking-wide flex items-center gap-2">
          <span>5.</span> Pricing, Goods and Services Tax (GST) & Invoicing
        </h2>
        <p>
          All pricing displayed on the Platform is listed in Indian Rupees (INR, ₹) and is subject to change without prior notice:
        </p>
        <ul class="list-disc pl-5 space-y-1.5">
          <li>
            <strong class="text-foreground">Taxes & GST:</strong> Prices are subject to applicable Goods and Services Tax (GST) under Indian statutory regulations. Tax amounts are transparently calculated and itemized during checkout and on your official tax invoice.
          </li>
          <li>
            <strong class="text-foreground">B2B GST Invoicing:</strong> Registered business entities requiring Input Tax Credit (ITC) must provide their legal registered entity name and valid GSTIN during checkout. Because tax invoices are generated automatically upon order confirmation, GSTIN details cannot be added or altered retroactively once an invoice has been generated.
          </li>
          <li>
            <strong class="text-foreground">Pricing Corrections:</strong> While we endeavor to ensure price accuracy, typographical or system errors may occasionally occur. If a product is listed at an incorrect price due to technical error, RS Prints reserves the right to cancel the order and provide a full refund of any amount paid.
          </li>
        </ul>
      </section>

      <!-- Section 6 -->
      <section class="space-y-3">
        <h2 class="text-base md:text-lg font-heading font-semibold text-foreground tracking-wide flex items-center gap-2">
          <span>6.</span> Payment Terms & Modes
        </h2>
        <p>
          We offer secure payment channels through RBI-licensed payment gateways and aggregators:
        </p>
        <ul class="list-disc pl-5 space-y-1.5">
          <li>
            <strong class="text-foreground">Accepted Methods:</strong> UPI (Google Pay, PhonePe, Paytm, BHIM), Net Banking, RuPay/Visa/MasterCard/Amex credit and debit cards, and authorized digital wallets.
          </li>
          <li>
            <strong class="text-foreground">Cash on Delivery (COD):</strong> Where COD is enabled for specific PIN codes, payment must be handed over in full prior to unpacking the parcel. Repeated refusal to accept COD orders without valid justification may result in permanent suspension of COD privileges.
          </li>
          <li>
            <strong class="text-foreground">Payment Security:</strong> All financial transactions are processed over encrypted 256-bit SSL connections directly with PCI-DSS compliant banking gateways. RS Prints does not hold or store card PINs, CVVs, or internet banking passwords.
          </li>
        </ul>
      </section>

      <!-- Section 7 -->
      <section class="space-y-3">
        <h2 class="text-base md:text-lg font-heading font-semibold text-foreground tracking-wide flex items-center gap-2">
          <span>7.</span> Shipping, Logistics & Delivery Rules
        </h2>
        <p>
          Products are dispatched across India through reputable third-party logistics carriers (e.g., Delhivery, BlueDart, Shiprocket, DTDC, India Post):
        </p>
        <ul class="list-disc pl-5 space-y-1.5">
          <li>
            <strong class="text-foreground">Indicative Delivery Timelines:</strong> Estimated delivery dates shown during checkout reflect production time plus standard courier transit times. While we make every endeavor to meet these timelines, delivery dates are indicative and not guaranteed deadlines.
          </li>
          <li>
            <strong class="text-foreground">Force Majeure:</strong> RS Prints shall not be held liable for transit delays caused by natural disasters, extreme weather, state borders, road closures, strikes, public holidays, or unforeseen carrier disruptions.
          </li>
          <li>
            <strong class="text-foreground">Accurate Address Undertaking:</strong> The customer must furnish complete delivery coordinates including house/plot number, street, city, landmark, correct 6-digit PIN code, and an active mobile number. We cannot be held liable for delivery failures resulting from incorrect address inputs.
          </li>
          <li>
            <strong class="text-foreground">Return to Origin (RTO) for Custom Goods:</strong> Because custom-printed items are made exclusively for you and cannot be re-stocked or sold to other customers, packages returned due to non-availability, wrong address, or customer refusal can only be re-dispatched upon payment of secondary courier freight charges.
          </li>
        </ul>
      </section>

      <!-- Section 8 -->
      <section class="space-y-3">
        <h2 class="text-base md:text-lg font-heading font-semibold text-foreground tracking-wide flex items-center gap-2">
          <span>8.</span> Cancellations, Replacements & Refund Policy
        </h2>
        <p>
          Our policy regarding order cancellations and defect claims is designed to be fair and transparent:
        </p>
        <ul class="list-disc pl-5 space-y-1.5">
          <li>
            <strong class="text-foreground">Custom Order Cancellations:</strong> Orders for customized apparel, bespoke gifts, and personalized merchandise can only be cancelled before our production department initiates proofing or physical printing (typically within 2 hours of placement). Once printing has commenced, custom orders cannot be cancelled or refunded.
          </li>
          <li>
            <strong class="text-foreground">Transit Damage & Defect Claims:</strong> If your order arrives physically damaged, has a verified manufacturing defect, or received an incorrect item, you must notify our customer support team at <a href={`mailto:${contact.email.support}`} class="text-primary hover:underline font-mono">{contact.email.support}</a> within <strong>seven (7) calendar days</strong> of delivery, providing clear unboxing photographs or video documentation.
          </li>
          <li>
            <strong class="text-foreground">Remedy:</strong> Upon verification of an authentic manufacturing flaw or transit damage, RS Prints will expedite a complimentary reprint and replacement or issue an approved refund.
          </li>
          <li>
            <strong class="text-foreground">Refund Processing:</strong> Approved refunds are credited back to the original source payment method (bank account, card, or UPI) within <strong>7 to 10 business days</strong>.
          </li>
        </ul>
      </section>

      <!-- Section 9 -->
      <section class="space-y-3">
        <h2 class="text-base md:text-lg font-heading font-semibold text-foreground tracking-wide flex items-center gap-2">
          <span>9.</span> Intellectual Property of RS Prints
        </h2>
        <p>
          All content appearing on this Platform—including software algorithms, website design layouts, text descriptions, product photographs, digital mockups, brand logos, graphics, and trade dress—is the exclusive intellectual property of {brand.legalName} or its technology licensors, protected under the <em>Indian Copyright Act, 1957</em> and the <em>Trade Marks Act, 1999</em>.
        </p>
        <p>
          You are granted a limited, revocable, non-exclusive license to access and browse the Platform solely to place orders. You are strictly prohibited from scraping, copying, reverse-engineering, republishing, or commercially exploiting our website code, catalogue assets, or user interface without explicit written consent.
        </p>
      </section>

      <!-- Section 10 -->
      <section class="space-y-3">
        <h2 class="text-base md:text-lg font-heading font-semibold text-foreground tracking-wide flex items-center gap-2">
          <span>10.</span> Limitation of Liability
        </h2>
        <p>
          To the maximum extent permitted by applicable Indian law, {brand.name}, its partners, directors, employees, or logistics agents shall not be liable for any indirect, incidental, punitive, special, or consequential damages (including loss of business, revenue, profits, goodwill, or data) arising from or relating to your use of the Platform or products ordered.
        </p>
        <p>
          In all events, the maximum cumulative financial liability of RS Prints to you for any and all claims, whether in contract, tort (including negligence), warranty, or otherwise, shall be strictly capped at the <strong>actual amount paid by you for the specific product or order</strong> giving rise to the claim.
        </p>
      </section>

      <!-- Section 11 -->
      <section class="space-y-3">
        <h2 class="text-base md:text-lg font-heading font-semibold text-foreground tracking-wide flex items-center gap-2">
          <span>11.</span> Grievance Redressal Mechanism & Officer Particulars
        </h2>
        <p>
          In accordance with the <em>Consumer Protection (E-Commerce) Rules, 2020</em> and Rule 3(2) of the <em>Information Technology (Intermediary Guidelines and Digital Media Ethics Code) Rules, 2021</em>, the particulars of our designated Grievance Officer are set forth below:
        </p>
        
        <div class="p-5 md:p-6 rounded-2xl border border-border bg-card/80 space-y-3 text-xs md:text-sm">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-left">
            <div>
              <span class="text-muted-foreground block text-xs uppercase tracking-wider font-semibold">Designation</span>
              <span class="font-medium text-foreground">Grievance & Customer Redressal Officer</span>
            </div>
            <div>
              <span class="text-muted-foreground block text-xs uppercase tracking-wider font-semibold">Entity Name</span>
              <span class="font-medium text-foreground">{brand.legalName} ({brand.name})</span>
            </div>
            <div>
              <span class="text-muted-foreground block text-xs uppercase tracking-wider font-semibold">Registered Office Address</span>
              <span class="font-medium text-foreground">
                {contact.address.line1}, {contact.address.line2}, {contact.address.city}, {contact.address.state} - {contact.address.postalCode}, India
              </span>
            </div>
            <div>
              <span class="text-muted-foreground block text-xs uppercase tracking-wider font-semibold">Email Contact</span>
              <a href={`mailto:${contact.email.support}?subject=Grievance%20Officer%20-%20Terms%20Inquiry`} class="text-primary hover:underline font-mono font-medium">
                {contact.email.support}
              </a>
              <span class="text-[11px] text-muted-foreground block mt-0.5">(Subject: "Attn: Grievance Officer - Terms")</span>
            </div>
            <div>
              <span class="text-muted-foreground block text-xs uppercase tracking-wider font-semibold">Helpline & WhatsApp</span>
              <span class="font-medium text-foreground font-mono">{contact.phone.display}</span>
            </div>
            <div>
              <span class="text-muted-foreground block text-xs uppercase tracking-wider font-semibold">Operational Hours</span>
              <span class="font-medium text-foreground">{contact.hours.display}</span>
            </div>
          </div>
          
          <div class="pt-3 border-t border-border/60 text-xs text-muted-foreground">
            <p>
              <strong class="text-foreground">Redressal Timelines:</strong> Our Grievance Officer shall acknowledge your formal complaint within <strong>forty-eight (48) hours</strong> of receipt and endeavor to resolve the grievance expeditiously within <strong>fifteen (15) to thirty (30) business days</strong>.
            </p>
          </div>
        </div>
      </section>

      <!-- Section 12 -->
      <section class="space-y-3">
        <h2 class="text-base md:text-lg font-heading font-semibold text-foreground tracking-wide flex items-center gap-2">
          <span>12.</span> Governing Law & Exclusive Jurisdiction
        </h2>
        <p>
          These Terms and Conditions, your relationship with RS Prints, and any dispute or claim arising out of or in connection with the purchase of products or use of this Platform shall be governed by and construed in accordance with the substantive laws of the <strong>Republic of India</strong>, without regard to conflict of law principles.
        </p>
        <p>
          The parties agree that subject to initial good-faith amicable dispute resolution efforts, the competent courts situated at <strong>{contact.address.city}, India</strong> shall have exclusive territorial jurisdiction over any disputes, lawsuits, or legal proceedings arising from or connected with these Terms.
        </p>
      </section>

      <!-- Section 13 -->
      <section class="space-y-3">
        <h2 class="text-base md:text-lg font-heading font-semibold text-foreground tracking-wide flex items-center gap-2">
          <span>13.</span> Severability & Entire Agreement
        </h2>
        <p>
          If any provision of these Terms is determined by a court of competent jurisdiction to be invalid, void, or unenforceable, such provision shall be severed to the minimum extent necessary, and the remaining provisions shall continue in full force and effect.
        </p>
        <p>
          These Terms, along with our Privacy Policy and Shipping & Refund Policy, constitute the entire agreement between you and {brand.name} with respect to your access to and use of the Platform and purchase of merchandise.
        </p>
      </section>

    </div>
  </main>
</Layout>
