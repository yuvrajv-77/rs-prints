---
import Layout from "@/layouts/main.astro"
import type { Product } from "@/types/product"
import { getRelatedProducts } from "@/data/products"
import ProductGallery from "@/components/product/ProductGallery"
import ProductConfigurator from "@/components/product/ProductConfigurator"
import ProductFaq from "@/components/product/ProductFaq"
import ProductStickyBar from "@/components/product/ProductStickyBar"
import RelatedProducts from "@/components/product/RelatedProducts.astro"
import {
  Breadcrumb,
  BreadcrumbList,
  BreadcrumbItem,
  BreadcrumbLink,
  BreadcrumbSeparator,
  BreadcrumbPage
} from "@/components/ui/breadcrumb"
import { Button } from "@/components/ui/button"
import { MessageCircleIcon, PhoneCallIcon } from "lucide-react"

interface Props {
  product: Product
  subcollection?: {
    id?: string
    name?: string
    slug?: string
  }
  parentCollection?: {
    id?: string
    name?: string
    slug?: string
  }
}

const { product, subcollection, parentCollection } = Astro.props

const relatedProducts = getRelatedProducts(product.slug, 3)

// SEO Schema markup: Product + FAQPage
const schemaMarkup = [
  {
    "@context": "https://schema.org",
    "@type": "Product",
    name: product.title,
    description: product.description || product.tagline,
    image: product.images.map((img) => img.url),
    brand: {
      "@type": "Brand",
      name: "RS Prints"
    },
    offers: {
      "@type": "Offer",
      price: product.startingPriceNumber,
      priceCurrency: "INR",
      availability: "https://schema.org/InStock",
      url: `https://rsprints.in/products/${product.slug}`
    },
    aggregateRating: {
      "@type": "AggregateRating",
      ratingValue: product.rating || 4.9,
      reviewCount: product.reviewCount || 150
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: product.faqs.map((faq) => ({
      "@type": "Question",
      name: faq.q,
      acceptedAnswer: {
        "@type": "Answer",
        text: faq.a
      }
    }))
  }
]
---

<Layout
  title={`${product.title} - RS Prints Custom Merchandise`}
  description={product.tagline}
  canonicalUrl={`/products/${product.slug}`}
  currentActive={product.slug}
  schemaMarkup={schemaMarkup}
>
  <div class="container mx-auto px-4 py-8">
    <!-- Breadcrumb using installed Breadcrumb UI component -->
    <Breadcrumb className="mb-6">
      <BreadcrumbList>
        <BreadcrumbItem>
          <BreadcrumbLink href="/">Home</BreadcrumbLink>
        </BreadcrumbItem>
        <BreadcrumbSeparator />
        <BreadcrumbItem>
          <BreadcrumbLink href="/products">Products</BreadcrumbLink>
        </BreadcrumbItem>
        {parentCollection && (
          <>
            <BreadcrumbSeparator />
            <BreadcrumbItem>
              <BreadcrumbLink href={`/products#${parentCollection.slug}`}>
                {parentCollection.name}
              </BreadcrumbLink>
            </BreadcrumbItem>
          </>
        )}
        {subcollection && subcollection.slug !== parentCollection?.slug && (
          <>
            <BreadcrumbSeparator />
            <BreadcrumbItem>
              <BreadcrumbLink href={`/products#${subcollection.slug}`}>
                {subcollection.name}
              </BreadcrumbLink>
            </BreadcrumbItem>
          </>
        )}
        <BreadcrumbSeparator />
        <BreadcrumbItem>
          <BreadcrumbPage>{product.title}</BreadcrumbPage>
        </BreadcrumbItem>
      </BreadcrumbList>
    </Breadcrumb>

    <!-- 2-Column Hero Product Area -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
      <!-- Left Column: Visual Gallery -->
      <div class="lg:col-span-6 lg:sticky lg:top-28">
        <ProductGallery
          client:load
          images={product.images}
          badge={product.badge}
          turnaround={product.turnaround}
        />
      </div>

      <!-- Right Column: Product Details & Configurator -->
      <div class="lg:col-span-6">
        <ProductConfigurator client:load product={product} />
      </div>
    </div>
    

    <!-- Slot for optional custom page injections -->
    <slot />

    <!-- Interactive FAQ Accordion -->
    <ProductFaq client:visible faqs={product.faqs} />

    <!-- Ready To Order / Custom Quote Banner -->
    <div class="mt-16 py-12 text-center space-y-4">
      <h3 class="text-2xl md:text-3xl font-extrabold tracking-tight text-foreground">
        Need Bulk Corporate Quotes or Custom Art Proofing?
      </h3>
      <p class="text-sm md:text-base text-muted-foreground max-w-xl mx-auto">
        Speak directly with our print specialists for institutional inquiries, Pantone color matching, and volume discounts.
      </p>
      <div class="pt-2 flex flex-wrap items-center justify-center gap-3">
        <a
          href={`https://wa.me/919876543210?text=${encodeURIComponent(
            `Hi RS Prints, I have a bulk printing requirement for ${product.title}.`
          )}`}
          target="_blank"
          rel="noopener noreferrer"
        >
          <Button size="lg" className="gap-2 ">
            <MessageCircleIcon className="size-4" />
            WhatsApp Bulk Desk
          </Button>
        </a>
        <a href="/contact">
          <Button variant="outline" size="lg" className="gap-2">
            <PhoneCallIcon className="size-4" />
            Submit Inquiry Form
          </Button>
        </a>
      </div>
    </div>

    <!-- Frequently Customized Together -->
    <RelatedProducts products={relatedProducts} />
  </div>

  <!-- Mobile Sticky Action Bar for handheld conversions -->
  <ProductStickyBar client:idle product={product} />
</Layout>
