---
import "@/styles/global.css"
import Navbar from "@/components/navbar"
import MobileNav from "@/components/navigation/MobileNav"
import BrandLogo from "@/components/BrandLogo"
import Footer from "@/components/footer"
import { Button } from "@/components/ui/button"
import UserNav from "@/components/UserNav"

interface Props {
  title?: string
  description?: string
  canonicalUrl?: string
  ogType?: string
  currentActive?:
    | "home"
    | "products"
    | "about"
    | "contact"
    | "t-shirts"
    | "mobile-case"
    | "key-chain"
    | "photo-frame"
    | "photo-frame-clock"
    | "cushion-cover"
    | "table-mat"
    | "water-bottle"
    | "cap"
    | "pens"
    | "banner"
    | (string & {})
  schemaMarkup?: Record<string, any> | Record<string, any>[]
}

const {
  title = "RS Prints - Custom Print Studio & Merchandise",
  description = "Crafting high-definition custom apparel, personalized photo gifts, drinkware, and corporate merchandise with precision printing delivered across India.",
  canonicalUrl,
  ogType = "website",
  currentActive = "home",
  schemaMarkup,
} = Astro.props

// Build absolute canonical URL
const siteUrl = "https://rsprints.in"
const finalCanonical = canonicalUrl ? `${siteUrl}${canonicalUrl}` : siteUrl
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
 
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={finalCanonical} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={finalCanonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${siteUrl}/og-image.png`} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={finalCanonical} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={`${siteUrl}/og-image.png`} />

    {
      schemaMarkup && (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify(schemaMarkup)}
        />
      )
    }
  </head>
  <body
    class="flex min-h-screen flex-col bg-background font-sans text-foreground antialiased selection:bg-primary/20"
  >
    <header class="sticky top-0 z-50 w-full border-b border-border/40 bg-background/95 backdrop-blur supports-[backdrop-filter]:bg-background/60">
      <!-- Desktop Navigation Bar (hidden on mobile) -->
      <div class="container mx-auto hidden md:flex h-20 items-center justify-between px-4">
        <BrandLogo />
        <Navbar client:load />
        <UserNav client:load />
      </div>

      <!-- Mobile Navigation Bar (visible only on mobile) -->
      <div class="block md:hidden">
        <MobileNav client:load />
      </div>
    </header>



    
    <!-- Main Content -->
    <main class="flex flex-1 flex-col">
      <slot />
    </main>

    <!-- Footer -->
    <Footer client:load />

    <!-- Ensure pure light mode -->
    <script is:inline>
      document.documentElement.classList.remove("dark")
      try {
        localStorage.removeItem("theme")
      } catch (e) {}
    </script>
  </body>
</html>
